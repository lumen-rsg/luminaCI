# ============================================================
# Lumina CI — Environment Variables
# Run ../scripts/init-env.sh to create .env and its file-backed secrets
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=<set-a-strong-password>

# RabbitMQ
RABBITMQ_PASSWORD=<set-a-strong-password>

# MinIO (S3 storage)
MINIO_USER=<set-minio-username>
MINIO_PASSWORD=<set-a-strong-password>

# Single HTTPS origin reachable by restricted Kubernetes build pods. The
# external nginx vhost forwards only the Fedora read path, snapshot reads, and
# artifact-bundle writes. The CIDR must be one exact /32 or /128 host.
KUBERNETES_BUILD_EGRESS_CIDR=146.120.224.52/32
KUBERNETES_RUNNER_ENDPOINT=packages.lumina.1t.ru:443
KUBERNETES_FEDORA_BASE_URL=https://packages.lumina.1t.ru/fedora

# JWT Authentication
# The secret signs both the short-lived access JWT (15 min) and is shared with
# every downstream service so they can independently re-validate tokens (SEC-04).
JWT_SECRET=<set-a-random-secret-min-32-characters>

# Cookie-based session lifetime (SEC-05). The access JWT lives in an HttpOnly,
# Secure, SameSite=Strict cookie; an opaque refresh token rotates it.
JWT_ACCESS_MINUTES=15   # access-token lifetime (short = small XSS/blast radius)
JWT_REFRESH_HOURS=8     # refresh-token lifetime = the session length
JWT_COOKIE_SECURE=true  # set false ONLY for plain-HTTP local dev

# File containing only the RPM signing-key passphrase. The file is mounted as a
# Docker secret; the passphrase is never accepted by the API or exposed in argv.
GPG_PASSPHRASE_FILE=./secrets/gpg-passphrase

# At-rest encryption master key for pipeline secrets (SEC-013).
# build-service uses this to encrypt WebhookSecret / GitToken columns with
# AES-256-GCM before they touch the database. Generate a strong random value
# (e.g. `openssl rand -base64 48`) and NEVER change it afterwards — doing so
# makes previously written secrets undecryptable. Required to start build-service.
SECRETS_MASTER_KEY=<set-a-random-secret-min-32-characters>
# Store SHA-256(SECRETS_MASTER_KEY) in this separate mode-0600 file before the
# first deployment. production-preflight.sh rejects later accidental rotation.
SECRETS_MASTER_KEY_FINGERPRINT_FILE=./secrets/secrets-master-key.sha256

# Initial admin account (seeded on first boot when the users table is empty).
# There are NO default credentials — the api-gateway refuses to start without ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-a-strong-password>

# Optional initial developer account (only seeded if DEVELOPER_PASSWORD is set)
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=

# LDAP (optional — leave empty to use built-in auth)
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ============================================================
# Build container isolation
# ============================================================
# Immutable application release manifest. Production deployments must use
# registry references pinned by digest so rollback never rebuilds old source.
API_GATEWAY_IMAGE=registry.example/lumina-api-gateway@sha256:<digest>
BUILD_SERVICE_IMAGE=registry.example/lumina-build-service@sha256:<digest>
SECURITY_SERVICE_IMAGE=registry.example/lumina-security-service@sha256:<digest>
SCANNER_SERVICE_IMAGE=registry.example/lumina-scanner-service@sha256:<digest>
REPOSITORY_SERVICE_IMAGE=registry.example/lumina-repository-service@sha256:<digest>
SOURCE_SERVICE_IMAGE=registry.example/lumina-source-service@sha256:<digest>
WEBAPP_IMAGE=registry.example/lumina-webapp@sha256:<digest>

# Optional OpenTelemetry Collector endpoint. When unset, trace and metric
# exporters are disabled. Production deployments should point this to an
# internal Collector rather than exposing OTLP publicly.
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<set-a-unique-observability-password>
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=30d
LUMINA_ENVIRONMENT=production

# These tune the per-build container that runs untrusted .spec files
# (dnf builddep + rpmbuild). Defaults are intentionally tight; only relax
# them if you understand the impact (see README.md → Безопасность сборок).
# The build container is NEVER placed on lumina-network and NEVER gets the
# host network.

# Docker bridge network that build containers are attached to. It is separate
# from lumina-network so builds cannot reach Postgres/RabbitMQ/MinIO/Trivy.
BUILD_NETWORK=lumina-buildnet

# Host path seen by the Docker daemon for build artifacts and source bind mounts.
HOST_DATA_ROOT=/opt/lumina

# Memory cap per build container, in bytes. memory-swap is pinned equal to
# this value, so builds cannot balloon into swap.
BUILD_MEMORY_BYTES=2147483648

# Maximum number of processes (PIDs) per build container — blunt fork bombs.
BUILD_PIDS_LIMIT=512

# CPU quota in microseconds per 100000us period (150000 = 1.5 CPUs).
BUILD_CPU_QUOTA=150000

# ============================================================
# TLS termination (SEC-020)
# ============================================================
# nginx terminates TLS for the console vhost (console.lumina.1t.ru) so that
# webhook tokens (GitLab X-Gitlab-Token) and the Secure session cookie travel
# over HTTPS end-to-end. The cert/key are NOT read from env — they are mounted
# as files from deploy/nginx/certs/ into the nginx container (see
# docker-compose.yml). Before bringing the stack up, place:
#   deploy/nginx/certs/console.crt  (fullchain)
#   deploy/nginx/certs/console.key  (private key, chmod 0400)
# Local-dev self-signed pair:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout deploy/nginx/certs/console.key \
#     -out deploy/nginx/certs/console.crt \
#     -subj "/CN=console.lumina.1t.ru"
# The :80 listener only redirects to :443; no app traffic is served in clear.
