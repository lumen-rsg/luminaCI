# ============================================================
# Lumina CI — Environment Variables
# Copy this file to .env and set real values before deploying
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=<set-a-strong-password>

# RabbitMQ
RABBITMQ_PASSWORD=<set-a-strong-password>

# MinIO (S3 storage)
MINIO_USER=<set-minio-username>
MINIO_PASSWORD=<set-a-strong-password>

# JWT Authentication
JWT_SECRET=<set-a-random-secret-min-32-characters>

# LDAP (optional — leave empty to use built-in auth)
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=