# ============================================================
# Lumina CI — Environment Variables
# Copy this file to .env and set real values before deploying
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=<set-a-strong-password>

# RabbitMQ
RABBITMQ_PASSWORD=<set-a-strong-password>

# MinIO (S3 storage)
MINIO_USER=<set-minio-username>
MINIO_PASSWORD=<set-a-strong-password>

# JWT Authentication
JWT_SECRET=<set-a-random-secret-min-32-characters>

# PGP signing key passphrase (used by security-service to sign published RPMs)
GPG_PASSPHRASE=<set-a-strong-passphrase>

# Initial admin account (seeded on first boot when the users table is empty).
# There are NO default credentials — the api-gateway refuses to start without ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-a-strong-password>

# Optional initial developer account (only seeded if DEVELOPER_PASSWORD is set)
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=

# LDAP (optional — leave empty to use built-in auth)
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=