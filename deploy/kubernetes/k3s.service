[Unit]
Description=Lumina Kubernetes control plane
Documentation=https://docs.k3s.io
Wants=network-online.target wg-quick@wg-lumina.service lumina-k3s-api-firewall.service
After=network-online.target wg-quick@wg-lumina.service lumina-k3s-api-firewall.service

[Service]
Type=notify
EnvironmentFile=-/etc/default/k3s
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStart=/usr/local/bin/k3s server --config /etc/rancher/k3s/config.yaml

[Install]
WantedBy=multi-user.target
