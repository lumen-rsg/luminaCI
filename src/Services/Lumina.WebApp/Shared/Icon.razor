@* Inline SVG icon (CSP-safe — no external font/webfont request).
   Usage: <Icon Name="Refresh" /> or <Icon Name="Plus" Class="me-1" />
   Sized by font-size / width+height utilities; color via currentColor. *@
@{
    if (!_paths.TryGetValue(Name, out var body))
    {
        body = _paths["circle"];
    }
}
