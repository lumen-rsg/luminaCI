    private string GetPipelineStatusBadge(PipelineStatus status) => status switch
    {
        PipelineStatus.Active => "badge bg-success",
        PipelineStatus.Draft => "badge bg-warning",
        PipelineStatus.Paused => "badge bg-secondary",
        PipelineStatus.Archived => "badge bg-dark",
        _ => "badge bg-secondary"
    };
