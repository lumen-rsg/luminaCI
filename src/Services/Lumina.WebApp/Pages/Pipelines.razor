    private async Task LoadPipelineDetails(Guid pipelineId)
    {
        try
        {
            var detail = await Api.GetPipelineAsync(pipelineId);
            if (detail?.Data != null)
            {
                _triggerPipelineHasGit = !string.IsNullOrEmpty(detail.Data.GitRepoUrl);
                _triggerPipelineGitUrl = detail.Data.GitRepoUrl ?? "";
                _triggerPipelineGitBranch = detail.Data.GitBranch ?? "main";

                if (!string.IsNullOrEmpty(detail.Data.SpecPath))
                    _triggerSpecName = System.IO.Path.GetFileName(detail.Data.SpecPath);
                else
                    _triggerSpecName = $"{detail.Data.Name}.spec";

                if (!string.IsNullOrEmpty(detail.Data.SpecContent))
                {
                    _triggerSpecContent = detail.Data.SpecContent;
                    _triggerSpecFileName = "";
                }

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load pipeline details for {PipelineId}", pipelineId);
        }
    }

