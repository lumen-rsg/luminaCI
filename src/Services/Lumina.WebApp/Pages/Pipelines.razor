    protected override async Task OnInitializedAsync()
    {
        var repositoriesTask = Api.GetRepositoriesAsync();
        await LoadPipelinesInternal();
        var repositories = await repositoriesTask;
        _repositories = repositories?.Data?.Repositories ?? [];
        _newPublishRepositoryId = _repositories.FirstOrDefault()?.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showDeleteConfirm && !_deleteDialogInitialized)
        {
            _deleteDialogInitialized = true;
            await JS.InvokeVoidAsync("activateAccessibleDialog", "delete-pipeline-dialog");
        }
    }

    private async Task LoadPipelinesInternal()
    {
        _loading = true;
        _error = false;
        try { _pipelines = await Api.GetPipelinesAsync(_pipelinePage, PipelinePageSize, _pipelineSearch); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pipelines");
            _error = true;
        }
        finally { _loading = false; }
    }

    private async Task ReloadPipelines()
    {
        await LoadPipelinesInternal();
    }

    private async Task SearchPipelines()
    {
        _pipelinePage = 1;
        await LoadPipelinesInternal();
    }

    private async Task ClearPipelineSearch()
    {
        _pipelineSearch = "";
        _pipelinePage = 1;
        await LoadPipelinesInternal();
    }

    private async Task ChangePipelinePage(int delta)
    {
        _pipelinePage = Math.Max(1, _pipelinePage + delta);
        await LoadPipelinesInternal();
    }

    private async Task ShowCreateDialog()
    {
        _showCreate = true;
        await Task.CompletedTask;
    }

    private async Task CreatePipeline()
    {
        if (!_newPublishRepositoryId.HasValue)
        {
            _triggerMessage = "Select a repository for the Publish step.";
            IsSuccess = false;
            return;
        }

        var tags = _newTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var steps = new List<CreatePipelineStepRequest>
        {
            new(StepType.Build, "Build RPM", 1, new Dictionary<string, string>()),
            new(StepType.Scan, "CVE Scan", 2, new Dictionary<string, string>()),
            new(StepType.Sign, "PGP Sign", 3, new Dictionary<string, string>()),
            new(StepType.Publish, "Publish", 4, new Dictionary<string, string>
            {
                ["repositoryId"] = _newPublishRepositoryId!.Value.ToString()
            })
        };

        var result = await Api.CreatePipelineAsync(new CreatePipelineRequest(
            _newName, _newDescription, steps, tags,
            string.IsNullOrWhiteSpace(_newGitRepoUrl) ? null : _newGitRepoUrl,
            string.IsNullOrWhiteSpace(_newGitBranch) ? null : _newGitBranch,
            string.IsNullOrWhiteSpace(_newSpecPath) ? null : _newSpecPath,
            string.IsNullOrWhiteSpace(_newWebhookSecret) ? null : _newWebhookSecret,
            string.IsNullOrWhiteSpace(_newBuildImage) ? null : _newBuildImage,
            string.IsNullOrWhiteSpace(_newGitUsername) ? null : _newGitUsername,
            string.IsNullOrWhiteSpace(_newGitToken) ? null : _newGitToken,
            string.IsNullOrWhiteSpace(_newSpecContent) ? null : _newSpecContent,
            "fedora", "44", _newTargetArchitecture,
            $"fedora-44-{_newTargetArchitecture}"));
        if (result?.Success == true)
        {
            var shouldAutoBuild = _autoBuildAfterCreate && !string.IsNullOrWhiteSpace(_newGitRepoUrl);
            var pipelineId = result.Data?.Id;

            _showCreate = false;
            _newName = "";
            _newDescription = "";
            _newTags = "";
            _newGitRepoUrl = "";
            _newGitBranch = "main";
            _newSpecPath = "";
            _newWebhookSecret = "";
            _newBuildImage = "";
            _newTargetArchitecture = "aarch64";
            _newGitUsername = "";
            _newGitToken = "";
            _newPublishRepositoryId = _repositories.FirstOrDefault()?.Id;
            _newSpecContent = "";
            _newSpecFileName = "";
            _autoBuildAfterCreate = false;
            _triggerMessage = "Pipeline created successfully!";
            IsSuccess = true;
            _pipelines = await Api.GetPipelinesAsync(_pipelinePage, PipelinePageSize, _pipelineSearch);

            // Auto-build if requested and git URL was configured
            if (shouldAutoBuild && pipelineId.HasValue)
            {
                try
                {
                    var buildResult = await Api.TriggerAutoBuildAsync(pipelineId.Value, "admin");
                    if (buildResult?.Success == true)
                    {
                        _triggerMessage = $"Pipeline created & auto-build triggered! Job ID: {buildResult.Data?.Id}";
                    }
                    else
                    {
                        _triggerMessage = $"Pipeline created, but auto-build failed: {buildResult?.Error ?? "Unknown error"}";
                        IsSuccess = false;
                    }
                }
                catch (Exception ex)
                {
                    _triggerMessage = $"Pipeline created, but auto-build error: {ex.Message}";
                    IsSuccess = false;
                }
            }
        }
        else
        {
            _triggerMessage = $"Failed: {result?.Error ?? "Unknown error"}";
            IsSuccess = false;
        }
    }

    private void ShowTriggerDialog(PipelineSummaryResponse pipeline)
    {
        _triggerPipelineId = pipeline.Id;
        _triggerPipelineName = pipeline.Name;
        _triggerSpecContent = "";
        _triggerSpecFileName = "";
        _triggerSourceUrl = "";
        _triggerMessage = null;

        _triggerPipelineHasGit = false;
        _triggerPipelineGitUrl = "";
        _triggerPipelineGitBranch = "main";

        _showTrigger = true;
        _ = LoadPipelineDetails(pipeline.Id);
    }

    private async Task LoadPipelineDetails(Guid pipelineId)
    {
        try
        {
            var detail = await Api.GetPipelineAsync(pipelineId);
            if (detail?.Data != null)
            {
                _triggerPipelineHasGit = !string.IsNullOrEmpty(detail.Data.GitRepoUrl);
                _triggerPipelineGitUrl = detail.Data.GitRepoUrl ?? "";
                _triggerPipelineGitBranch = detail.Data.GitBranch ?? "main";

                if (!string.IsNullOrEmpty(detail.Data.SpecPath))
                    _triggerSpecName = System.IO.Path.GetFileName(detail.Data.SpecPath);
                else
                    _triggerSpecName = $"{detail.Data.Name}.spec";

                if (!string.IsNullOrEmpty(detail.Data.SpecContent))
                {
                    _triggerSpecContent = detail.Data.SpecContent;
                    _triggerSpecFileName = "";
                }

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load pipeline details for {PipelineId}", pipelineId);
        }
    }

    private async Task AutoBuild(Guid pipelineId, string pipelineName)
    {
        try
        {
            var result = await Api.TriggerAutoBuildAsync(pipelineId, "admin");
            if (result?.Success == true)
            {
                _triggerMessage = $"Auto build triggered for '{pipelineName}'! Job ID: {result.Data?.Id}";
                IsSuccess = true;
            }
            else
            {
                _triggerMessage = $"Failed: {result?.Error ?? "Unknown error"}";
                IsSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _triggerMessage = $"Error: {ex.Message}";
            IsSuccess = false;
            Logger.LogError(ex, "Failed to auto-trigger pipeline {PipelineId}", pipelineId);
        }
    }

    private async Task TriggerPipeline()
    {
        try
        {
            var request = new TriggerBuildRequest(
                _triggerSpecName,
                _triggerSpecContent,
                string.IsNullOrWhiteSpace(_triggerSourceUrl) ? null : _triggerSourceUrl,
                _triggeredBy
            );

            var result = await Api.TriggerPipelineWithRequestAsync(_triggerPipelineId, request);
            if (result?.Success == true)
            {
                _triggerMessage = $"Build triggered successfully! Job ID: {result.Data?.Id}";
                IsSuccess = true;
                _showTrigger = false;
            }
            else
            {
                _triggerMessage = $"Failed: {result?.Error ?? "Unknown error"}";
                IsSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _triggerMessage = $"Error: {ex.Message}";
            IsSuccess = false;
            Logger.LogError(ex, "Failed to trigger pipeline");
        }
    }

    private async Task CopyWebhookUrl(Guid pipelineId)
    {
        try
        {
            var detail = await Api.GetPipelineAsync(pipelineId);
            if (detail?.Data?.WebhookUrl != null)
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", detail.Data.WebhookUrl);
                _triggerMessage = $"Webhook URL copied: {detail.Data.WebhookUrl}";
                IsSuccess = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _triggerMessage = $"Could not copy: {ex.Message}";
            IsSuccess = false;
            Logger.LogWarning(ex, "Failed to copy webhook URL");
        }
    }

    private async Task ShowEditDialog(PipelineSummaryResponse pipeline)
    {
        var requestVersion = ++_editRequestVersion;
        _showEdit = false;
        _edit = null;
        _editLoadError = null;
        _editLoading = true;
        StateHasChanged();

        try
        {
            var detail = await Api.GetPipelineAsync(pipeline.Id);
            if (requestVersion != _editRequestVersion)
                return;

            if (detail?.Success != true || detail.Data == null)
            {
                _editLoadError = $"Could not load pipeline details: {detail?.Error ?? "Unknown error"}";
                return;
            }

            _edit = EditPipelineModel.From(detail.Data);
            _showEdit = true;
        }
        catch (Exception ex)
        {
            if (requestVersion == _editRequestVersion)
                _editLoadError = "Could not load pipeline details. Please try again.";
            Logger.LogWarning(ex, "Failed to load pipeline details for edit {PipelineId}", pipeline.Id);
        }
        finally
        {
            if (requestVersion == _editRequestVersion)
            {
                _editLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task SaveEditPipeline()
    {
        var edit = _edit;
        if (!_showEdit || edit == null || _savingEdit || !edit.PublishRepositoryId.HasValue)
            return;

        _savingEdit = true;
        try
        {
            var tags = edit.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            var steps = new List<CreatePipelineStepRequest>
            {
                new(StepType.Build, "Build RPM", 1, new Dictionary<string, string>()),
                new(StepType.Scan, "CVE Scan", 2, new Dictionary<string, string>()),
                new(StepType.Sign, "PGP Sign", 3, new Dictionary<string, string>()),
                new(StepType.Publish, "Publish", 4, new Dictionary<string, string>
                {
                    ["repositoryId"] = edit.PublishRepositoryId!.Value.ToString()
                })
            };

            var result = await Api.UpdatePipelineAsync(edit.Id, new UpdatePipelineRequest(
                edit.Name, edit.Description, steps, tags,
                edit.GitRepoUrl, edit.GitBranch, edit.SpecPath, edit.BuildImage,
                edit.GitUsername,
                string.IsNullOrWhiteSpace(edit.GitToken) ? null : edit.GitToken,
                string.IsNullOrWhiteSpace(edit.SpecContent) ? null : edit.SpecContent,
                edit.ExpectedUpdatedAt,
                "fedora", "44", edit.TargetArchitecture,
                $"fedora-44-{edit.TargetArchitecture}"));

            if (result?.Success == true)
            {
                DismissEdit();
                _triggerMessage = "Pipeline updated successfully!";
                IsSuccess = true;
                _pipelines = await Api.GetPipelinesAsync(_pipelinePage, PipelinePageSize, _pipelineSearch);
            }
            else
            {
                _triggerMessage = $"Update failed: {result?.Error ?? "Unknown error"}";
                IsSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _triggerMessage = $"Error: {ex.Message}";
            IsSuccess = false;
        }
        finally
        {
            _savingEdit = false;
        }
    }

    private void DismissEdit()
    {
        _editRequestVersion++;
        _showEdit = false;
        _editLoading = false;
        _editLoadError = null;
        _edit = null;
    }

