    private async Task OnCreateSpecFileUploaded(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _newSpecContent = await reader.ReadToEndAsync();
            _newSpecFileName = file.Name;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to read spec file {FileName}", file.Name);
        }
    }

