
@page "/pipelines"
@using Lumina.Shared.DTOs
@using Lumina.Shared.Models.Enums
@inject Lumina.WebApp.Services.LuminaApiService Api
@inject ILogger<Pipelines> Logger
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Pipelines — Lumina CI</PageTitle>

<div class="page-header">
    <h1>🔄 Pipelines</h1>
    <div class="page-header-actions">
        <button class="btn btn-primary" @onclick="ShowCreateDialog">+ New Pipeline</button>
    </div>
</div>

<!-- Create Pipeline Dialog -->
@if (_showCreate)
{
    <div class="card mb-4 animate-slide-in" style="border-color:var(--accent);">
        <div class="card-header" style="background:rgba(56,139,253,0.1);">
            <h4 class="mb-0">+ Create Pipeline</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" @bind="_newName" placeholder="my-package-build" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control" @bind="_newDescription" placeholder="Build pipeline for..." />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Tags (comma-separated)</label>
                <input type="text" class="form-control" @bind="_newTags" placeholder="rpm, production" />
            </div>

            <div class="section-title mt-4">🔗 Git Integration (optional)</div>
            <div class="mb-3">
                <label class="form-label">Git Repository URL</label>
                <input type="text" class="form-control" @bind="_newGitRepoUrl" placeholder="https://github.com/example/my-package.git" />
                <div class="form-text">If set, sources will be automatically cloned on each build</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Branch</label>
                    <input type="text" class="form-control" @bind="_newGitBranch" placeholder="main" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Spec File Path</label>
                    <input type="text" class="form-control" @bind="_newSpecPath" placeholder="my-package.spec" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Webhook Secret</label>
                <input type="text" class="form-control" @bind="_newWebhookSecret" placeholder="Secret for webhook verification" />
            </div>

            <div class="section-title mt-4">🔐 Git Credentials (for private repositories)</div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Git Username</label>
                    <input type="text" class="form-control" @bind="_newGitUsername" placeholder="git-user or token name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Git Token / Password</label>
                    <input type="password" class="form-control" @bind="_newGitToken" placeholder="Personal Access Token" />
                </div>
            </div>

            <div class="section-title mt-4">🐳 Build Environment</div>
            <div class="mb-3">
                <label class="form-label">Build Image</label>
                <select class="form-select" @bind="_newBuildImage">
                    <option value="">Default (rpm-build — Fedora + RPM tools)</option>
                    <option value="lumina-dotnet-build:latest">.NET / NativeAOT (Fedora + .NET 10 SDK + clang)</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">RPM Spec Content</label>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="btn btn-outline-primary btn-sm mb-0">
                        📁 Загрузить .spec файл
                        <InputFile OnChange="@OnCreateSpecFileUploaded" Accept=".spec,.spec.in" style="display:none" />
                    </label>
                    @if (!string.IsNullOrEmpty(_newSpecFileName))
                    {
                        <span class="text-sm text-muted">📎 @_newSpecFileName</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => { _newSpecContent = ""; _newSpecFileName = ""; })" title="Очистить">✕</button>
                    }
                </div>
                <textarea class="form-control font-monospace" rows="8" @bind="_newSpecContent" style="font-size:0.82rem;" placeholder="Name: my-package
Version: 1.0
..."></textarea>
                <div class="form-text">Загрузите .spec файл или введите содержимое вручную. Требуется, если в git-репозитории нет .spec файла.</div>
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="autoBuildCheck" @bind="_autoBuildAfterCreate" />
                <label class="form-check-label" for="autoBuildCheck">▶ Auto-build after creation (requires Git URL)</label>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-success" @onclick="CreatePipeline">Create Pipeline</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Trigger Build Dialog -->
@if (_showTrigger)
{
    <div class="card mb-4 animate-slide-in" style="border-color:var(--accent-green);">
        <div class="card-header" style="background:rgba(63,185,80,0.1);">
            <h4 class="mb-0">▶ Trigger Build — @_triggerPipelineName</h4>
        </div>
        <div class="card-body">
            @if (_triggerPipelineHasGit)
            {
                <div class="alert alert-info">
                    <strong>🔗 Git source configured!</strong> Sources will be automatically cloned from the git repository.
                </div>
            }
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Package Spec Name</label>
                    <input type="text" class="form-control" @bind="_triggerSpecName" placeholder="my-package" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Triggered By</label>
                    <input type="text" class="form-control" @bind="_triggeredBy" placeholder="admin" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Source URL</label>
                <input type="text" class="form-control" @bind="_triggerSourceUrl" placeholder="https://github.com/example/my-package/archive/v1.0.tar.gz" />
                @if (_triggerPipelineHasGit)
                {
                    <div class="form-text">Leave empty to auto-clone from <code>@_triggerPipelineGitUrl</code> (branch: @_triggerPipelineGitBranch)</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">RPM Spec Content</label>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="btn btn-outline-primary btn-sm mb-0">
                        📁 Загрузить .spec файл
                        <InputFile OnChange="@OnTriggerSpecFileUploaded" Accept=".spec,.spec.in" style="display:none" />
                    </label>
                    @if (!string.IsNullOrEmpty(_triggerSpecFileName))
                    {
                        <span class="text-sm text-muted">📎 @_triggerSpecFileName</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => { _triggerSpecContent = ""; _triggerSpecFileName = ""; })" title="Очистить">✕</button>
                    }
                </div>
                <textarea class="form-control font-monospace" rows="10" @bind="_triggerSpecContent" style="font-size:0.82rem;"></textarea>
                @if (_triggerPipelineHasGit)
                {
                    <div class="form-text">Leave empty — spec will be read from the cloned git repository.</div>
                }
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="TriggerPipeline">▶ Run Build</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showTrigger = false">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Edit Pipeline Dialog -->
@if (_showEdit)
{
    <div class="card mb-4 animate-slide-in" style="border-color:var(--accent-yellow, #f0ad4e);">
        <div class="card-header" style="background:rgba(240,173,78,0.1);">
            <h4 class="mb-0">✏️ Edit Pipeline — @_editName</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" @bind="_editName" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control" @bind="_editDescription" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Tags (comma-separated)</label>
                <input type="text" class="form-control" @bind="_editTags" />
            </div>
            <div class="section-title mt-4">🔗 Git Integration</div>
            <div class="mb-3">
                <label class="form-label">Git Repository URL</label>
                <input type="text" class="form-control" @bind="_editGitRepoUrl" />
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Branch</label>
                    <input type="text" class="form-control" @bind="_editGitBranch" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Spec File Path</label>
                    <input type="text" class="form-control" @bind="_editSpecPath" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Git Username</label>
                    <input type="text" class="form-control" @bind="_editGitUsername" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Git Token / Password</label>
                    <input type="password" class="form-control" @bind="_editGitToken" placeholder="Leave empty to keep current" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Build Image</label>
                <select class="form-select" @bind="_editBuildImage">
                    <option value="">Default (rpm-build)</option>
                    <option value="lumina-dotnet-build:latest">.NET / NativeAOT</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">RPM Spec Content (inline)</label>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="btn btn-outline-primary btn-sm mb-0">
                        📁 Загрузить .spec файл
                        <InputFile OnChange="@OnEditSpecFileUploaded" Accept=".spec,.spec.in" style="display:none" />
                    </label>
                    @if (!string.IsNullOrEmpty(_editSpecFileName))
                    {
                        <span class="text-sm text-muted">📎 @_editSpecFileName</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => { _editSpecContent = ""; _editSpecFileName = ""; })" title="Очистить">✕</button>
                    }
                </div>
                <textarea class="form-control font-monospace" rows="6" @bind="_editSpecContent" style="font-size:0.82rem;"></textarea>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-warning" @onclick="SaveEditPipeline">💾 Save Changes</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showEdit = false">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteConfirm)
{
    <div class="card mb-4 animate-slide-in" style="border-color:var(--danger, #dc3545);">
        <div class="card-header" style="background:rgba(220,53,69,0.1);">
            <h4 class="mb-0">🗑️ Delete Pipeline — @_deletePipelineName?</h4>
        </div>
        <div class="card-body">
            <p>Are you sure you want to delete pipeline <strong>@_deletePipelineName</strong>?</p>
            <p class="text-muted text-sm">This action cannot be undone. Build history will be preserved.</p>
            <div class="d-flex gap-2">
                <button class="btn btn-danger" @onclick="DeletePipeline">🗑️ Delete</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showDeleteConfirm = false">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Alert Messages -->
@if (_triggerMessage != null)
{
    <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show animate-slide-in">
        @_triggerMessage
        <button type="button" class="btn-close" @onclick="() => _triggerMessage = null"></button>
    </div>
}

    @if (_error)
    {
        <div class="card animate-slide-in">
            <div class="card-body text-center p-5">
                <div style="font-size:3rem;">⚠️</div>
                <h4 class="mt-3">Сервер временно недоступен</h4>
                <p class="text-muted">Не удалось загрузить список пайплайнов. Проверьте подключение к серверу и попробуйте снова.</p>
                <button class="btn btn-primary mt-2" @onclick="ReloadPipelines">🔄 Повторить</button>
            </div>
        </div>
    }
    else if (_loading)
    {
        <div class="card"><div class="card-body p-4">
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
        </div></div>
    }
    else if (_pipelines?.Data?.Pipelines != null && _pipelines.Data.Pipelines.Any())
{
    <div class="section-title">
        @(_pipelines.Data.TotalCount) Pipeline(s)
    </div>

    @foreach (var pipeline in _pipelines.Data.Pipelines)
    {
        <div class="card animate-slide-in" style="cursor:default;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-1">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h4 class="mb-0">@pipeline.Name</h4>
                            <span class="@GetPipelineStatusBadge(pipeline.Status)">@pipeline.Status</span>
                            @if (!string.IsNullOrEmpty(pipeline.GitRepoUrl))
                            {
                                <span class="badge bg-info" title="@pipeline.GitRepoUrl">
                                    🔗 @ExtractHost(pipeline.GitRepoUrl)
                                </span>
                                @if (!string.IsNullOrEmpty(pipeline.GitBranch))
                                {
                                    <span class="badge bg-secondary" title="Branch">
                                        🌿 @pipeline.GitBranch
                                    </span>
                                }
                            }
                        </div>
                        <div class="text-sm text-muted mb-2">@pipeline.Description</div>
                        <div class="d-flex align-items-center gap-3 text-xs text-muted">
                            <span>👤 @pipeline.CreatedBy</span>
                            <span>📅 @pipeline.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            <span>🔢 @pipeline.StepCount steps</span>
                        </div>
                    </div>
                        <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(pipeline.GitRepoUrl))
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => AutoBuild(pipeline.Id, pipeline.Name)" title="Auto Build — fetch from git">
                                    ⚡ Auto
                                </button>
                                <button class="btn btn-sm btn-outline-info" @onclick="() => CopyWebhookUrl(pipeline.Id)" title="Copy webhook URL">
                                    📋 Webhook
                                </button>
                            }
                        <button class="btn btn-sm btn-outline-success" @onclick="() => ShowTriggerDialog(pipeline)" title="Manual Build">
                            ▶ Run
                        </button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ShowEditDialog(pipeline)" title="Edit Pipeline">
                            ✏️ Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(pipeline)" title="Delete Pipeline">
                            🗑️
                        </button>
                        <button class="btn btn-sm @(IsSourcesExpanded(pipeline.Id) ? "btn-info" : "btn-outline-info")" @onclick="() => TogglePipelineSources(pipeline.Id)" title="Extra Sources">
                            📦 Sources
                        </button>
                        <a href="/builds" class="btn btn-sm btn-outline-primary" title="View Builds">
                            📋 Builds
                        </a>
                    </div>
                </div>
                <!-- Extra Sources Section -->
                @if (IsSourcesExpanded(pipeline.Id))
                {
                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--border, #dee2e6);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">📦 Extra Sources <span class="text-muted text-sm">(patches, archives, etc.)</span></h6>
                        </div>
                        <p class="text-sm text-muted mb-2">Files uploaded here will be copied to <code>SOURCES/</code> inside the build container on every build. Use subfolders to organize.</p>

                        <div class="row mb-2">
                            <div class="col-md-8">
                                <div class="d-flex gap-2 align-items-center">
                                    <label class="btn btn-primary btn-sm mb-0 @(_uploading ? "disabled" : "")">
                                        📤 Upload Files
                                        <InputFile OnChange="@(e => OnExtraSourceUploaded(e, pipeline.Id))" Accept=".tar.gz,.tar.bz2,.tar.xz,.tgz,.zip,.patch,.diff,.gz,.bz2,.xz,.rar,.7z,.tar" multiple style="display:none" disabled="@_uploading" />
                                    </label>
                                    <input type="text" class="form-control form-control-sm" style="max-width:200px"
                                           @bind:get="GetSubfolderBinding(pipeline.Id)"
                                           @bind:set="(v) => SetSubfolder(pipeline.Id, v)"
                                           placeholder="Subfolder (optional)" disabled="@_uploading" />
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                @if (GetPipelineSourcesList(pipeline.Id)?.Count > 0 && !_uploading)
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ClearSources(pipeline.Id)" title="Delete all extra sources">🗑️ Clear All</button>
                                }
                            </div>
                        </div>

                        @if (_uploading)
                        {
                            <div class="mb-3 p-2 rounded" style="background:rgba(56,139,253,0.05); border:1px solid rgba(56,139,253,0.2);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-sm">
                                        📤 @(_uploadFileCount > 1 ? $"File {_uploadFileIndex}/{_uploadFileCount}: " : "")<strong>@_uploadFileName</strong>
                                    </span>
                                    <span class="text-sm text-muted">
                                        @FormatFileSize(_uploadBytesRead) / @FormatFileSize(_uploadTotalBytes) — @_uploadPercent.ToString("F0")%
                                    </span>
                                </div>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                                         role="progressbar"
                                         style="width: @_uploadPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                         aria-valuenow="@_uploadPercent.ToString("F0")"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @_uploadPercent.ToString("F0")%
                                    </div>
                                </div>
                            </div>
                        }

                        @if (IsSourcesLoading(pipeline.Id))
                        {
                            <div class="text-sm text-muted">Loading...</div>
                        }
                        else if (GetPipelineSourcesList(pipeline.Id) is { Count: > 0 } files)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm" style="font-size:0.82rem;">
                                    <thead><tr><th>File</th><th>Subfolder</th><th>Size</th><th>Uploaded</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var src in files)
                                        {
                                            <tr>
                                                <td class="font-monospace">@src.FileName</td>
                                                <td>@(src.SubFolder ?? "/")</td>
                                                <td>@FormatFileSize(src.FileSize)</td>
                                                <td>@src.UploadedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                                <td><button class="btn btn-outline-danger btn-sm py-0 px-1" style="font-size:0.75rem" @onclick="() => DeleteSource(pipeline.Id, src.Path)">✕</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-sm text-muted fst-italic">No extra sources uploaded yet</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="mt-3 text-sm text-muted">
        Total: @_pipelines.Data.TotalCount pipeline(s)
    </div>
}
else
{
    <div class="empty-state animate-slide-in">
        <div class="empty-state-icon">🔄</div>
        <h3>No pipelines yet</h3>
        <p>Click "New Pipeline" to create your first build pipeline.</p>
    </div>
}

@code {
    private ApiResponse<PipelineListResponse>? _pipelines;
    private bool _loading = true;
    private bool _error = false;
    private bool _showCreate = false;
    private string _newName = "";
    private string _newDescription = "";
    private string _newTags = "";
    private string _newGitRepoUrl = "";
    private string _newGitBranch = "main";
    private string _newSpecPath = "";
    private string _newWebhookSecret = "";
    private string _newBuildImage = "";
    private string _newGitUsername = "";
    private string _newGitToken = "";
    private string _newSpecContent = "";
    private string _newSpecFileName = "";
    private bool _autoBuildAfterCreate = false;

    // Trigger build dialog
    private bool _showTrigger = false;
    private Guid _triggerPipelineId;
    private string _triggerPipelineName = "";
    private bool _triggerPipelineHasGit = false;
    private string _triggerPipelineGitUrl = "";
    private string _triggerPipelineGitBranch = "main";
    private string _triggerSpecName = "lumina-hello";
    private string _triggerSourceUrl = "";
    private string _triggeredBy = "admin";
    private string? _triggerMessage;
    private bool IsSuccess;

    // Edit dialog
    private bool _showEdit = false;
    private Guid _editId;
    private string _editName = "";
    private string _editDescription = "";
    private string _editTags = "";
    private string _editGitRepoUrl = "";
    private string _editGitBranch = "main";
    private string _editSpecPath = "";
    private string _editBuildImage = "";
    private string _editGitUsername = "";
    private string _editGitToken = "";
    private string _editSpecContent = "";
    private string _editSpecFileName = "";

    // Delete dialog
    private bool _showDeleteConfirm = false;
    private Guid _deletePipelineId;
    private string _deletePipelineName = "";

    private readonly string _defaultSpec = @"Name:           lumina-hello
Version:        1.0.0
Release:        1%{?dist}
Summary:        Hello World from Lumina CI

License:        MIT
Source0:        %{name}-%{version}.tar.gz

%description
A simple test package built by Lumina CI.

%prep
%setup -q

%install
mkdir -p %{buildroot}/usr/bin
echo ""#!/bin/bash"" > %{buildroot}/usr/bin/lumina-hello
echo ""echo Hello from Lumina CI! v1.0.0"" >> %{buildroot}/usr/bin/lumina-hello
chmod +x %{buildroot}/usr/bin/lumina-hello

%files
/usr/bin/lumina-hello
";

    private string _triggerSpecContent = "";
    private string _triggerSpecFileName = "";

    // Extra sources state
    private readonly HashSet<Guid> _expandedSources = new();
    private readonly HashSet<Guid> _loadingSources = new();
    private readonly Dictionary<Guid, List<UploadedSourceResponse>> _pipelineSources = new();
    private readonly Dictionary<Guid, string> _subfolders = new();
    private readonly Dictionary<Guid, CancellationTokenSource> _uploadCts = new();

    // Upload progress state
    private bool _uploading;
    private string _uploadFileName = "";
    private long _uploadBytesRead;
    private long _uploadTotalBytes;
    private double _uploadPercent;
    private int _uploadFileIndex;
    private int _uploadFileCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadPipelinesInternal();
    }

    private async Task LoadPipelinesInternal()
    {
        _loading = true;
        _error = false;
        try { _pipelines = await Api.GetPipelinesAsync(1, 50); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pipelines");
            _error = true;
        }
        finally { _loading = false; }
    }

    private async Task ReloadPipelines()
    {
        await LoadPipelinesInternal();
    }

    private async Task ShowCreateDialog()
    {
        _showCreate = true;
        await Task.CompletedTask;
    }

    private async Task CreatePipeline()
    {
        var tags = _newTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var steps = new List<CreatePipelineStepRequest>
        {
            new(StepType.Build, "Build RPM", 1, new Dictionary<string, string>()),
            new(StepType.Scan, "CVE Scan", 2, new Dictionary<string, string>()),
            new(StepType.Sign, "PGP Sign", 3, new Dictionary<string, string>()),
            new(StepType.Publish, "Publish", 4, new Dictionary<string, string>())
        };

        var result = await Api.CreatePipelineAsync(new CreatePipelineRequest(
            _newName, _newDescription, steps, tags,
            string.IsNullOrWhiteSpace(_newGitRepoUrl) ? null : _newGitRepoUrl,
            string.IsNullOrWhiteSpace(_newGitBranch) ? null : _newGitBranch,
            string.IsNullOrWhiteSpace(_newSpecPath) ? null : _newSpecPath,
            string.IsNullOrWhiteSpace(_newWebhookSecret) ? null : _newWebhookSecret,
            string.IsNullOrWhiteSpace(_newBuildImage) ? null : _newBuildImage,
            string.IsNullOrWhiteSpace(_newGitUsername) ? null : _newGitUsername,
            string.IsNullOrWhiteSpace(_newGitToken) ? null : _newGitToken,
            string.IsNullOrWhiteSpace(_newSpecContent) ? null : _newSpecContent));
        if (result?.Success == true)
        {
            var shouldAutoBuild = _autoBuildAfterCreate && !string.IsNullOrWhiteSpace(_newGitRepoUrl);
            var pipelineId = result.Data?.Id;

            _showCreate = false;
            _newName = "";
            _newDescription = "";
            _newTags = "";
            _newGitRepoUrl = "";
            _newGitBranch = "main";
            _newSpecPath = "";
            _newWebhookSecret = "";
            _newBuildImage = "";
            _newGitUsername = "";
            _newGitToken = "";
            _newSpecContent = "";
            _newSpecFileName = "";
            _autoBuildAfterCreate = false;
            _triggerMessage = "✅ Pipeline created successfully!";
            IsSuccess = true;
            _pipelines = await Api.GetPipelinesAsync(1, 50);

            // Auto-build if requested and git URL was configured
            if (shouldAutoBuild && pipelineId.HasValue)
            {
                try
                {
                    var buildResult = await Api.TriggerAutoBuildAsync(pipelineId.Value, "admin");
                    if (buildResult?.Success == true)
                    {
                        _triggerMessage = $"✅ Pipeline created & auto-build triggered! Job ID: {buildResult.Data?.Id}";
                    }
                    else
                    {
                        _triggerMessage = $"⚠️ Pipeline created, but auto-build failed: {buildResult?.Error ?? "Unknown error"}";
                        IsSuccess = false;
                    }
                }
                catch (Exception ex)
                {
                    _triggerMessage = $"⚠️ Pipeline created, but auto-build error: {ex.Message}";
                    IsSuccess = false;
                }
            }
        }
        else
        {
            _triggerMessage = $"❌ Failed: {result?.Error ?? "Unknown error"}";
            IsSuccess = false;
        }
    }

