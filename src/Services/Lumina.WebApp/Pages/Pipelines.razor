    // === Extra Sources Methods ===
    private bool IsSourcesExpanded(Guid pipelineId) => _expandedSources.Contains(pipelineId);
    private bool IsSourcesLoading(Guid pipelineId) => _loadingSources.Contains(pipelineId);
    private List<UploadedSourceResponse>? GetPipelineSourcesList(Guid pipelineId)
        => _pipelineSources.TryGetValue(pipelineId, out var list) ? list : null;
    private string GetSubfolderBinding(Guid pipelineId)
        => _subfolders.TryGetValue(pipelineId, out var val) ? val : "";

    private void SetSubfolder(Guid pipelineId, string value) => _subfolders[pipelineId] = value;

    private async Task TogglePipelineSources(Guid pipelineId)
    {
        if (_expandedSources.Contains(pipelineId))
        {
            _expandedSources.Remove(pipelineId);
        }
        else
        {
            _expandedSources.Add(pipelineId);
            await LoadPipelineSourcesAsync(pipelineId);
        }
    }

    private async Task LoadPipelineSourcesAsync(Guid pipelineId)
    {
        _loadingSources.Add(pipelineId);
        StateHasChanged();
        try
        {
            var result = await Api.GetPipelineSourcesAsync(pipelineId);
            _pipelineSources[pipelineId] = result?.Data ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load extra sources for pipeline {PipelineId}", pipelineId);
            _pipelineSources[pipelineId] = new();
        }
        finally
        {
            _loadingSources.Remove(pipelineId);
            StateHasChanged();
        }
    }

    private async Task OnExtraSourceUploaded(InputFileChangeEventArgs e, Guid pipelineId)
    {
        _uploading = true;
        _uploadFileCount = e.FileCount;
        _uploadFileIndex = 0;
        StateHasChanged();

        try
        {
            var subfolder = _subfolders.TryGetValue(pipelineId, out var sf) ? sf : "";
            subfolder = string.IsNullOrWhiteSpace(subfolder) ? null : subfolder.Trim().Trim('/', '\\');

            foreach (var file in e.GetMultipleFiles(e.FileCount))
            {
                _uploadFileIndex++;
                _uploadFileName = file.Name;
                _uploadBytesRead = 0;
                _uploadPercent = 0;
                _uploadTotalBytes = (long)file.Size;
                StateHasChanged();

                var progress = new Progress<(long Uploaded, long Total)>(p =>
                {
                    _uploadBytesRead = p.Uploaded;
                    _uploadTotalBytes = p.Total;
                    _uploadPercent = p.Total > 0 ? p.Uploaded * 100.0 / p.Total : 0;
                    InvokeAsync(StateHasChanged);
                });

                // Run upload on background thread so Blazor circuit can render progress
                await Task.Run(async () =>
                {
                    using var stream = file.OpenReadStream(maxAllowedSize: long.MaxValue);
                    await Api.UploadPipelineSourceAsync(pipelineId, stream, file.Name, subfolder, progress);
                });
            }

            _triggerMessage = $"✅ Uploaded {e.FileCount} file(s) to pipeline sources";
            IsSuccess = true;
            await LoadPipelineSourcesAsync(pipelineId);
        }
        catch (Exception ex)
        {
            _triggerMessage = $"❌ Upload failed: {ex.Message}";
            IsSuccess = false;
            Logger.LogWarning(ex, "Failed to upload extra sources for pipeline {PipelineId}", pipelineId);
        }
        finally
        {
            _uploading = false;
            _uploadFileName = "";
            _uploadBytesRead = 0;
            _uploadPercent = 0;
            StateHasChanged();
        }
    }

    private async Task DeleteSource(Guid pipelineId, string path)
    {
        try
        {
            // Extract relative path from full path (format: "pipelines/{id}/...")
            var prefix = $"pipelines/{pipelineId}/";
            var relativePath = path.StartsWith(prefix) ? path[prefix.Length..] : path;

            await Api.DeletePipelineSourceAsync(pipelineId, relativePath);
            await LoadPipelineSourcesAsync(pipelineId);
        }
        catch (Exception ex)
        {
            _triggerMessage = $"❌ Delete failed: {ex.Message}";
            IsSuccess = false;
            Logger.LogWarning(ex, "Failed to delete extra source {Path}", path);
        }
    }

    private async Task ClearSources(Guid pipelineId)
