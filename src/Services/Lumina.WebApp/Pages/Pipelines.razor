
@page "/pipelines"
@using Lumina.Shared.DTOs
@using Lumina.Shared.Models.Enums
@inject Lumina.WebApp.Services.LuminaApiService Api
@inject ILogger<Pipelines> Logger
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Pipelines — Lumina CI</PageTitle>

<div class="page-header">
    <h1>Pipelines</h1>
    <div class="page-header-actions">
        <button class="btn btn-primary" @onclick="ShowCreateDialog"><Icon Name="plus" /> New Pipeline</button>
    </div>
</div>

<div class="filter-bar">
    <label class="visually-hidden" for="pipeline-search">Search pipelines</label>
    <input id="pipeline-search" class="form-control form-control-sm" style="max-width:320px"
           placeholder="Search name or description" @bind="_pipelineSearch" @bind:event="oninput" />
    <button class="btn btn-sm btn-outline-primary" @onclick="SearchPipelines">Search</button>
    @if (!string.IsNullOrWhiteSpace(_pipelineSearch))
    {
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearPipelineSearch">Clear</button>
    }
</div>

<!-- Create Pipeline Form -->
@if (_showCreate)
{
    <div class="card mb-4 animate-slide-in" role="region" aria-labelledby="create-pipeline-title">
        <div class="card-header">
            <h4 id="create-pipeline-title" class="mb-0"><Icon Name="plus" /> Create Pipeline</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="new-pipeline-name">Name</label>
                    <input id="new-pipeline-name" type="text" class="form-control" @bind="_newName" placeholder="my-package-build" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="new-pipeline-description">Description</label>
                    <input id="new-pipeline-description" type="text" class="form-control" @bind="_newDescription" placeholder="Build pipeline for..." />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="new-pipeline-tags">Tags (comma-separated)</label>
                <input id="new-pipeline-tags" type="text" class="form-control" @bind="_newTags" placeholder="rpm, production" />
            </div>

            <div class="section-title mt-4">Git Integration (optional)</div>
            <div class="mb-3">
                <label class="form-label" for="new-pipeline-git-url">Git Repository URL</label>
                <input id="new-pipeline-git-url" type="url" class="form-control" @bind="_newGitRepoUrl" placeholder="https://github.com/example/my-package.git" />
                <div class="form-text">If set, sources will be automatically cloned on each build</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="new-pipeline-branch">Branch</label>
                    <input id="new-pipeline-branch" type="text" class="form-control" @bind="_newGitBranch" placeholder="main" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="new-pipeline-spec-path">Spec File Path</label>
                    <input id="new-pipeline-spec-path" type="text" class="form-control" @bind="_newSpecPath" placeholder="my-package.spec" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="new-pipeline-webhook-secret">Webhook Secret</label>
                <input id="new-pipeline-webhook-secret" type="password" class="form-control" autocomplete="new-password" @bind="_newWebhookSecret" placeholder="Secret for webhook verification" />
            </div>

            <div class="section-title mt-4">Git Credentials (for private repositories)</div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="new-pipeline-git-username">Git Username</label>
                    <input id="new-pipeline-git-username" type="text" class="form-control" autocomplete="username" @bind="_newGitUsername" placeholder="git-user or token name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="new-pipeline-git-token">Git Token / Password</label>
                    <input id="new-pipeline-git-token" type="password" class="form-control" autocomplete="new-password" @bind="_newGitToken" placeholder="Personal Access Token" />
                </div>
            </div>

            <div class="section-title mt-4">Build Environment</div>
            <div class="mb-3">
                <label class="form-label" for="new-pipeline-build-image">Build Image</label>
                <select id="new-pipeline-build-image" class="form-select" @bind="_newBuildImage">
                    <option value="">Default (rpm-build — Fedora + RPM tools)</option>
                    <option value="lumina-dotnet-build:f44-v1">.NET / NativeAOT (Fedora 44 + .NET 10.0.104 + clang)</option>
                </select>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="new-pipeline-target">Target</label>
                    <input id="new-pipeline-target" class="form-control" value="Fedora 44" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="new-pipeline-architecture">Architecture</label>
                    <select id="new-pipeline-architecture" class="form-select" @bind="_newTargetArchitecture">
                        <option value="aarch64">aarch64</option>
                        <option value="x86_64">x86_64</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="new-pipeline-publish-repository">Publish Repository</label>
                <select id="new-pipeline-publish-repository" class="form-select" @bind="_newPublishRepositoryId">
                    <option value="">Select a repository</option>
                    @foreach (var repository in _repositories)
                    {
                        <option value="@repository.Id">@repository.DisplayName (@repository.Arch)</option>
                    }
                </select>
                <div class="form-text">The Publish step runs automatically after Scan and Sign succeed.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="new-pipeline-spec-content">RPM Spec Content</label>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <InputFile id="new-pipeline-spec-upload" class="visually-hidden-file-input" OnChange="@OnCreateSpecFileUploaded" Accept=".spec,.spec.in" />
                    <label for="new-pipeline-spec-upload" class="btn btn-outline-primary btn-sm mb-0">Upload .spec file</label>
                    @if (!string.IsNullOrEmpty(_newSpecFileName))
                    {
                        <span class="text-sm text-muted">@_newSpecFileName</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => { _newSpecContent = ""; _newSpecFileName = ""; })" title="Clear" aria-label="Clear uploaded create-pipeline spec"><Icon Name="x" /></button>
                    }
                </div>
                <textarea id="new-pipeline-spec-content" class="form-control font-monospace" rows="8" @bind="_newSpecContent" style="font-size:0.82rem;" placeholder="Name: my-package
Version: 1.0
..."></textarea>
                <div class="form-text">Upload a .spec file or enter content manually. Required if the git repository has no .spec file.</div>
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="autoBuildCheck" @bind="_autoBuildAfterCreate" />
                <label class="form-check-label" for="autoBuildCheck">Auto-build after creation (requires Git URL)</label>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-success" @onclick="CreatePipeline" disabled="@(!_newPublishRepositoryId.HasValue)">Create Pipeline</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Trigger Build Form -->
@if (_showTrigger)
{
    <div class="card mb-4 animate-slide-in" role="region" aria-labelledby="trigger-build-title">
        <div class="card-header">
            <h4 id="trigger-build-title" class="mb-0">Trigger Build — @_triggerPipelineName</h4>
        </div>
        <div class="card-body">
            @if (_triggerPipelineHasGit)
            {
                <div class="alert alert-info">
                    <strong>Git source configured!</strong> Sources will be automatically cloned from the git repository.
                </div>
            }
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="trigger-spec-name">Package Spec Name</label>
                    <input id="trigger-spec-name" type="text" class="form-control" @bind="_triggerSpecName" placeholder="my-package" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="triggered-by">Triggered By</label>
                    <input id="triggered-by" type="text" class="form-control" @bind="_triggeredBy" placeholder="admin" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="trigger-source-url">Source URL</label>
                <input id="trigger-source-url" type="url" class="form-control" @bind="_triggerSourceUrl" placeholder="https://github.com/example/my-package/archive/v1.0.tar.gz" />
                @if (_triggerPipelineHasGit)
                {
                    <div class="form-text">Leave empty to auto-clone from <code>@_triggerPipelineGitUrl</code> (branch: @_triggerPipelineGitBranch)</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label" for="trigger-spec-content">RPM Spec Content</label>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <InputFile id="trigger-spec-upload" class="visually-hidden-file-input" OnChange="@OnTriggerSpecFileUploaded" Accept=".spec,.spec.in" />
                    <label for="trigger-spec-upload" class="btn btn-outline-primary btn-sm mb-0">Upload .spec file</label>
                    @if (!string.IsNullOrEmpty(_triggerSpecFileName))
                    {
                        <span class="text-sm text-muted">@_triggerSpecFileName</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => { _triggerSpecContent = ""; _triggerSpecFileName = ""; })" title="Clear" aria-label="Clear uploaded trigger spec"><Icon Name="x" /></button>
                    }
                </div>
                <textarea id="trigger-spec-content" class="form-control font-monospace" rows="10" @bind="_triggerSpecContent" style="font-size:0.82rem;"></textarea>
                @if (_triggerPipelineHasGit)
                {
                    <div class="form-text">Leave empty — spec will be read from the cloned git repository.</div>
                }
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="TriggerPipeline">Run Build</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showTrigger = false">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Edit Pipeline Form -->
@if (_editLoading)
{
    <div class="card mb-4 animate-slide-in">
        <div class="card-body d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm"></span>
            <span>Loading pipeline details...</span>
        </div>
    </div>
}
else if (_editLoadError != null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center">
        <span>@_editLoadError</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="DismissEdit">Dismiss</button>
    </div>
}
else if (_showEdit && _edit != null)
{
    <div class="card mb-4 animate-slide-in" role="region" aria-labelledby="edit-pipeline-title">
        <div class="card-header">
            <h4 id="edit-pipeline-title" class="mb-0">Edit Pipeline — @_edit.Name</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="edit-pipeline-name">Name</label>
                    <input id="edit-pipeline-name" type="text" class="form-control" @bind="_edit.Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="edit-pipeline-description">Description</label>
                    <input id="edit-pipeline-description" type="text" class="form-control" @bind="_edit.Description" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="edit-pipeline-tags">Tags (comma-separated)</label>
                <input id="edit-pipeline-tags" type="text" class="form-control" @bind="_edit.Tags" />
            </div>
            <div class="section-title mt-4">Git Integration</div>
            <div class="mb-3">
                <label class="form-label" for="edit-pipeline-git-url">Git Repository URL</label>
                <input id="edit-pipeline-git-url" type="url" class="form-control" @bind="_edit.GitRepoUrl" />
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="edit-pipeline-branch">Branch</label>
                    <input id="edit-pipeline-branch" type="text" class="form-control" @bind="_edit.GitBranch" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-pipeline-spec-path">Spec File Path</label>
                    <input id="edit-pipeline-spec-path" type="text" class="form-control" @bind="_edit.SpecPath" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="edit-pipeline-git-username">Git Username</label>
                    <input id="edit-pipeline-git-username" type="text" class="form-control" autocomplete="username" @bind="_edit.GitUsername" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-pipeline-git-token">Git Token / Password</label>
                    <input id="edit-pipeline-git-token" type="password" class="form-control" autocomplete="new-password" @bind="_edit.GitToken" placeholder="Leave empty to keep current" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="edit-pipeline-build-image">Build Image</label>
                <select id="edit-pipeline-build-image" class="form-select" @bind="_edit.BuildImage">
                    <option value="">Default (rpm-build)</option>
                    <option value="lumina-dotnet-build:f44-v1">.NET / NativeAOT</option>
                </select>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="edit-pipeline-target">Target</label>
                    <input id="edit-pipeline-target" class="form-control" value="Fedora 44" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-pipeline-architecture">Architecture</label>
                    <select id="edit-pipeline-architecture" class="form-select" @bind="_edit.TargetArchitecture">
                        <option value="aarch64">aarch64</option>
                        <option value="x86_64">x86_64</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="edit-pipeline-publish-repository">Publish Repository</label>
                <select id="edit-pipeline-publish-repository" class="form-select" @bind="_edit.PublishRepositoryId">
                    <option value="">Select a repository</option>
                    @foreach (var repository in _repositories)
                    {
                        <option value="@repository.Id">@repository.DisplayName (@repository.Arch)</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="edit-pipeline-spec-content">RPM Spec Content (inline)</label>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <InputFile id="edit-pipeline-spec-upload" class="visually-hidden-file-input" OnChange="@OnEditSpecFileUploaded" Accept=".spec,.spec.in" />
                    <label for="edit-pipeline-spec-upload" class="btn btn-outline-primary btn-sm mb-0">Upload .spec file</label>
                    @if (!string.IsNullOrEmpty(_edit.SpecFileName))
                    {
                        <span class="text-sm text-muted">@_edit.SpecFileName</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => { _edit.SpecContent = ""; _edit.SpecFileName = ""; })" title="Clear" aria-label="Clear uploaded edit spec"><Icon Name="x" /></button>
                    }
                </div>
                <textarea id="edit-pipeline-spec-content" class="form-control font-monospace" rows="6" @bind="_edit.SpecContent" style="font-size:0.82rem;"></textarea>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-warning" @onclick="SaveEditPipeline" disabled="@(_savingEdit || !_edit.PublishRepositoryId.HasValue)">
                    @(_savingEdit ? "Saving..." : "Save Changes")
                </button>
                <button class="btn btn-outline-secondary" @onclick="DismissEdit" disabled="@_savingEdit">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <div id="delete-pipeline-dialog" class="card modal-card animate-slide-in" role="dialog"
             aria-modal="true" aria-labelledby="delete-pipeline-title" @onclick:stopPropagation="true">
            <div class="card-header">
                <h4 id="delete-pipeline-title" class="mb-0">Delete Pipeline — @_deletePipelineName?</h4>
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete pipeline <strong>@_deletePipelineName</strong>?</p>
                <p class="text-muted text-sm">This action cannot be undone. Build history will be preserved.</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-danger" @onclick="DeletePipeline">Delete</button>
                    <button class="btn btn-outline-secondary" data-dialog-close autofocus @onclick="CloseDeleteDialog">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Alert Messages -->
@if (_triggerMessage != null)
{
    <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show animate-slide-in" role="status" aria-live="polite">
        @_triggerMessage
        <button type="button" class="btn-close" @onclick="() => _triggerMessage = null" aria-label="Dismiss pipeline message"></button>
    </div>
}

    @if (_error)
    {
        <div class="card animate-slide-in">
            <div class="card-body text-center p-5">
                <div><span class="status-dot failed"></span></div>
                <h4 class="mt-3">Server Unavailable</h4>
                <p class="text-muted">Could not load pipelines. Check your connection and try again.</p>
                <button class="btn btn-primary mt-2" @onclick="ReloadPipelines">Retry</button>
            </div>
        </div>
    }
    else if (_loading)
    {
        <div class="card"><div class="card-body p-4">
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
        </div></div>
    }
    else if (_pipelines?.Data?.Pipelines != null && _pipelines.Data.Pipelines.Any())
{
    <div class="section-title">
        @(_pipelines.Data.TotalCount) Pipeline(s)
    </div>

    @foreach (var pipeline in _pipelines.Data.Pipelines)
    {
        <PipelineSummaryCard Pipeline="pipeline"
                             SourcesExpanded="@IsSourcesExpanded(pipeline.Id)"
                             AutoBuild="@((PipelineSummaryResponse p) => AutoBuild(p.Id, p.Name))"
                             CopyWebhook="@((PipelineSummaryResponse p) => CopyWebhookUrl(p.Id))"
                             Run="ShowTriggerDialog"
                             Edit="ShowEditDialog"
                             Delete="ConfirmDelete"
                             ToggleSources="@((PipelineSummaryResponse p) => TogglePipelineSources(p.Id))">
                <!-- Extra Sources Section -->
                @if (IsSourcesExpanded(pipeline.Id))
                {
                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-light);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Extra Sources <span class="text-muted text-sm">(patches, archives, etc.)</span></h6>
                        </div>
                        <p class="text-sm text-muted mb-2">Files uploaded here will be copied to <code>SOURCES/</code> inside the build container on every build. Use subfolders to organize.</p>

                        <div class="row mb-2">
                            <div class="col-md-8">
                                <div class="d-flex gap-2 align-items-center">
                                    <InputFile id="@($"extra-source-upload-{pipeline.Id}")" class="visually-hidden-file-input"
                                               OnChange="@(e => OnExtraSourceUploaded(e, pipeline.Id))"
                                               Accept=".tar.gz,.tar.bz2,.tar.xz,.tgz,.zip,.patch,.diff,.gz,.bz2,.xz,.rar,.7z,.tar"
                                               multiple disabled="@_uploading" />
                                    <label for="@($"extra-source-upload-{pipeline.Id}")" class="btn btn-primary btn-sm mb-0 @(_uploading ? "disabled" : "")">Upload Files</label>
                                    <label class="visually-hidden" for="@($"extra-source-subfolder-{pipeline.Id}")">Optional source subfolder</label>
                                    <input id="@($"extra-source-subfolder-{pipeline.Id}")" type="text" class="form-control form-control-sm" style="max-width:200px"
                                           @bind:get="GetSubfolderBinding(pipeline.Id)"
                                           @bind:set="(v) => SetSubfolder(pipeline.Id, v)"
                                           placeholder="Subfolder (optional)" disabled="@_uploading" />
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                @if (GetPipelineSourcesList(pipeline.Id)?.Count > 0 && !_uploading)
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ClearSources(pipeline.Id)" title="Delete all extra sources">Clear All</button>
                                }
                            </div>
                        </div>

                        @if (_uploading)
                        {
                            <div class="mb-3 p-3" style="background:var(--tint-blue); border:1px solid var(--border-color); border-radius:var(--radius-sm);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-sm">
                                        @(_uploadFileCount > 1 ? $"File {_uploadFileIndex}/{_uploadFileCount}: " : "")<strong>@_uploadFileName</strong>
                                    </span>
                                    <span class="text-sm text-muted">
                                        @FormatFileSize(_uploadBytesRead) / @FormatFileSize(_uploadTotalBytes) — @_uploadPercent.ToString("F0")%
                                    </span>
                                </div>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                                         role="progressbar"
                                         style="width: @_uploadPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                         aria-valuenow="@_uploadPercent.ToString("F0")"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @_uploadPercent.ToString("F0")%
                                    </div>
                                </div>
                            </div>
                        }

                        @if (IsSourcesLoading(pipeline.Id))
                        {
                            <div class="text-sm text-muted">Loading...</div>
                        }
                        else if (GetPipelineSourcesList(pipeline.Id) is { Count: > 0 } files)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm" style="font-size:0.82rem;">
                                    <caption class="visually-hidden">Extra source files for @pipeline.Name</caption>
                                    <thead><tr><th scope="col">File</th><th scope="col">Subfolder</th><th scope="col">Size</th><th scope="col">Uploaded</th><th scope="col">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var src in files)
                                        {
                                            <tr>
                                                <td class="font-monospace">@src.FileName</td>
                                                <td>@(src.SubFolder ?? "/")</td>
                                                <td>@FormatFileSize(src.FileSize)</td>
                                                <td>@src.UploadedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                                <td><button class="btn btn-outline-danger btn-sm py-0 px-1" style="font-size:0.75rem" @onclick="() => DeleteSource(pipeline.Id, src.Path)" aria-label="Delete source @src.FileName"><Icon Name="x" /></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-sm text-muted fst-italic">No extra sources uploaded yet</div>
                        }
                    </div>
                }
        </PipelineSummaryCard>
    }

    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-sm text-muted">
            Showing @_pipelines.Data.Pipelines.Count of @_pipelines.Data.TotalCount matching pipelines
        </span>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm" disabled="@(_pipelinePage <= 1)"
                    @onclick="() => ChangePipelinePage(-1)">Prev</button>
            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@(_pipelinePage * PipelinePageSize >= _pipelines.Data.TotalCount)"
                    @onclick="() => ChangePipelinePage(1)">Next</button>
        </div>
    </div>
}
else
{
    <div class="empty-state animate-slide-in">
        <div class="empty-state-icon"><Icon Name="flow" /></div>
        <h3>No pipelines yet</h3>
        <p>Click "New Pipeline" to create your first build pipeline.</p>
    </div>
}

@code {
    private ApiResponse<PipelineListResponse>? _pipelines;
    private bool _loading = true;
    private bool _error = false;
