@page "/builds"
@using Lumina.Shared.DTOs
@using Lumina.Shared.Models.Enums
@inject Lumina.WebApp.Services.LuminaApiService Api
@inject ILogger<Builds> Logger
@inject NavigationManager Navigation

<PageTitle>Builds — Lumina CI</PageTitle>

<div class="page-header">
    <h1>Builds</h1>
    <div class="page-header-actions">
        <a href="/pipelines" class="btn btn-outline-success"><Icon Name="play" /> Trigger Build</a>
        <button class="btn btn-outline-danger" @onclick="ClearQueue" title="Clear all queued builds"><Icon Name="trash" /> Clear Queue</button>
        <button class="btn btn-outline-secondary" @onclick="LoadBuilds"><Icon Name="refresh" /> Refresh</button>
    </div>
</div>

    <!-- Filter Bar -->
    @if (!_error)
    {
        <div class="filter-bar">
            <span class="text-xs text-muted" style="margin-right:4px;">Filter:</span>
            <button class="filter-btn @_allActive" @onclick="FilterAll">
                All
            </button>
            <button class="filter-btn @_successActive" @onclick="FilterSuccess">
                <span class="badge-dot green"></span> Success
            </button>
            <button class="filter-btn @_failedActive" @onclick="FilterFailed">
                <span class="badge-dot red"></span> Failed
            </button>
            <button class="filter-btn @_buildingActive" @onclick="FilterBuilding">
                <span class="badge-dot blue"></span> Building
            </button>
            <button class="filter-btn @_queuedActive" @onclick="FilterQueued">
                <span class="badge-dot yellow"></span> Queued
            </button>
        </div>
    }

    <!-- Error State -->
    @if (_error)
    {
        <div class="card animate-slide-in">
            <div class="card-body text-center p-5">
                <div class="empty-state-icon"><Icon Name="alert-circle" /></div>
                <h4 class="mt-3">Server Unavailable</h4>
                <p class="text-muted">Could not load builds. Check your connection and try again.</p>
                <button class="btn btn-primary mt-2" @onclick="LoadBuilds"><Icon Name="refresh" /> Retry</button>
            </div>
        </div>
    }
    else if (_loading)
{
    <div class="card">
        <div class="card-body p-4">
            <div class="skeleton skeleton-title w-100"></div>
            <div class="skeleton skeleton-text w-100"></div>
            <div class="skeleton skeleton-text w-100"></div>
            <div class="skeleton skeleton-text w-100" style="width:60%"></div>
        </div>
    </div>
}
else if (CurrentBuilds.Any())
{
    <div class="card animate-slide-in">
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <caption class="visually-hidden">Build history</caption>
                <thead>
                        <tr>
                            <th scope="col" style="width:6px;padding:0;"><span class="visually-hidden">Status indicator</span></th>
                            <th scope="col">Build</th>
                            <th scope="col">Spec Name</th>
                            <th scope="col">Status</th>
                            <th scope="col">Git</th>
                            <th scope="col">Pipeline</th>
                            <th scope="col">Triggered By</th>
                            <th scope="col">Started</th>
                            <th scope="col" style="width:80px;">Actions</th>
                        </tr>
                </thead>
                <tbody>
                    @foreach (var build in CurrentBuilds)
                    {
                        var statusColor = build.Status switch
                        {
                            BuildStatus.Success => "var(--accent-green)",
                            BuildStatus.Failed => "var(--accent-red)",
                            BuildStatus.Building => "var(--accent)",
                            BuildStatus.Queued => "var(--accent-yellow)",
                            _ => "var(--text-primary)"
                        };
                        <tr class="clickable-row"
                            role="link"
                            tabindex="0"
                            aria-label="View build @build.Id"
                            @onclick="() => NavigateToBuild(build.Id)"
                            @onkeydown="args => HandleBuildRowKeyDown(args, build.Id)">
                            <td style="width:6px;padding:0;background:@statusColor;"></td>
                            <td>
                                <code>@build.Id.ToString()[..8]</code>
                            </td>
                            <td>
                                <strong class="text-bright">@build.SpecName</strong>
                            </td>
                            <td>
                                @if (build.Status == BuildStatus.Building)
                                {
                                    <span class="badge bg-primary building-pulse">
                                        <span class="badge-dot blue"></span> Building
                                    </span>
                                }
                                else if (build.Status == BuildStatus.Queued)
                                {
                                    <span class="badge bg-warning">
                                        <span class="badge-dot yellow"></span> Queued
                                    </span>
                                }
                                else if (build.Status == BuildStatus.Success)
                                {
                                    <span class="badge bg-success">
                                        <span class="badge-dot green"></span> Success
                                    </span>
                                }
                                else if (build.Status == BuildStatus.Failed)
                                {
                                    <span class="badge bg-danger">
                                        <span class="badge-dot red"></span> Failed
                                    </span>
                                }
                                else if (build.Status == BuildStatus.Cancelled)
                                {
                                    <span class="badge bg-dark">
                                        <span class="badge-dot" style="background:var(--text-primary);"></span> Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@build.Status</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(build.CommitSha))
                                {
                                    <code title="@build.CommitSha" style="font-size:0.8em;">@build.CommitSha[..Math.Min(7, build.CommitSha.Length)]</code>
                                    @if (!string.IsNullOrEmpty(build.Branch))
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size:0.7em;">@build.Branch</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                <code>@build.PipelineId.ToString()[..8]</code>
                            </td>
                            <td class="text-sm">@build.TriggeredBy</td>
                            <td class="text-sm text-muted">
                                @build.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")
                            </td>
                            <td class="d-flex gap-2" @onkeydown:stopPropagation>
                                @if (build.Status == BuildStatus.Queued || build.Status == BuildStatus.Building)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelBuild(build.Id)" @onclick:stopPropagation title="Cancel build">
                                        <Icon Name="cancel" /> Cancel
                                    </button>
                                }
                                <a href="/builds/@build.Id" class="btn btn-sm btn-outline-primary" @onclick:stopPropagation>
                                    <Icon Name="chevron-right" /> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-sm text-muted">
            Showing @CurrentBuilds.Count() of @(_builds?.Data?.TotalCount ?? 0) matching builds
        </span>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm" disabled="@(_page <= 1)" @onclick="() => ChangePage(-1)"><Icon Name="chevron-left" /> Prev</button>
            <button class="btn btn-outline-secondary btn-sm" disabled="@(_page * 20 >= (_builds?.Data?.TotalCount ?? 0))" @onclick="() => ChangePage(1)">Next <Icon Name="chevron-right" /></button>
        </div>
    </div>
}
else
{
    <div class="empty-state animate-slide-in">
        <div class="empty-state-icon"><Icon Name="inbox" /></div>
        <h3>No builds found</h3>
        <p>@(_filter != "all" ? "No builds match the selected filter. Try changing the filter." : "Trigger a pipeline to start your first build.")</p>
    </div>
}

@code {
    private ApiResponse<BuildListResponse>? _builds;
    private bool _loading = true;
    private bool _error = false;
    private int _page = 1;
    private string _filter = "all";

    private IEnumerable<BuildJobSummaryResponse> CurrentBuilds =>
        _builds?.Data?.Builds ?? Enumerable.Empty<BuildJobSummaryResponse>();

    protected override async Task OnInitializedAsync()
    {
        await LoadBuilds();
    }

    private async Task LoadBuilds()
    {
        _loading = true;
        _error = false;
        StateHasChanged();
        try { _builds = await Api.GetBuildsAsync(_page, 20, SelectedStatus); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load builds");
            _error = true;
        }
        finally { _loading = false; }
    }

    private string _allActive => _filter == "all" ? "active" : "";
    private string _successActive => _filter == "success" ? "active" : "";
    private string _failedActive => _filter == "failed" ? "active" : "";
    private string _buildingActive => _filter == "building" ? "active" : "";
    private string _queuedActive => _filter == "queued" ? "active" : "";

    private BuildStatus? SelectedStatus => _filter switch
    {
        "success" => BuildStatus.Success,
        "failed" => BuildStatus.Failed,
        "building" => BuildStatus.Building,
        "queued" => BuildStatus.Queued,
        _ => null
    };

    private async Task SetFilter(string filter)
    {
        _filter = filter;
        _page = 1;
        await LoadBuilds();
    }

    private Task FilterAll() => SetFilter("all");
    private Task FilterSuccess() => SetFilter("success");
    private Task FilterFailed() => SetFilter("failed");
    private Task FilterBuilding() => SetFilter("building");
    private Task FilterQueued() => SetFilter("queued");

    private async Task CancelBuild(Guid buildId)
    {
        try
        {
            await Api.CancelBuildAsync(buildId);
            await LoadBuilds();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel build {BuildId}", buildId);
        }
    }

    private async Task ClearQueue()
    {
        try
        {
            await Api.ClearBuildQueueAsync();
            await LoadBuilds();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clear build queue");
        }
    }

    private async Task ChangePage(int delta)
    {
        _page += delta;
        _loading = true;
        await LoadBuilds();
    }

    private void NavigateToBuild(Guid buildId) => Navigation.NavigateTo($"/builds/{buildId}");

    private void HandleBuildRowKeyDown(KeyboardEventArgs args, Guid buildId)
    {
        if (args.Key == "Enter")
        {
            NavigateToBuild(buildId);
        }
    }
}
