@page "/security"
@using Lumina.Shared.DTOs
@inject Lumina.WebApp.Services.LuminaApiService Api
@inject ILogger<Security> Logger

<PageTitle>Security — Lumina CI</PageTitle>

<div class="page-header">
    <h1><Icon Name="shield" /> Security</h1>
    <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshAll"><Icon Name="refresh" /> Refresh</button>
</div>

<div class="row">
    <!-- PGP Key Management & Signing -->
    <div class="col-md-6">
        <div class="card animate-slide-in">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="mb-0"><Icon Name="key" /> PGP Keys &amp; Signing</h3>
                <button class="btn btn-sm btn-outline-primary" @onclick="ToggleGenerateKey">
                    <Icon Name="@(_showGenerateKey ? "x" : "plus")" /> @(_showGenerateKey ? "Cancel" : "Generate Key")
                </button>
            </div>
            <div class="card-body">
                @if (_showGenerateKey)
                {
                    <div class="p-3 mb-3" style="background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                        <h6>Generate New PGP Key</h6>
                        <div class="mb-2">
                            <label class="form-label small">Key Name</label>
                            <input type="text" class="form-control form-control-sm" @bind="_keyName" placeholder="lumina-build-key" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Email</label>
                            <input type="email" class="form-control form-control-sm" @bind="_keyEmail" placeholder="build@lumina-ci.local" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Passphrase</label>
                            <input type="password" class="form-control form-control-sm" @bind="_keyPassphrase" placeholder="Optional" />
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="GenerateKey" disabled="@(_generatingKey)">
                            @if (_generatingKey)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            Generate
                        </button>
                        @if (_keyResult != null)
                        {
                            <div class="alert @(string.IsNullOrEmpty(_keyResult.Error) ? "alert-success" : "alert-danger") mt-2 mb-0 py-1 px-2 small">
                                @(string.IsNullOrEmpty(_keyResult.Error) ? (_keyResult.Message ?? "Key generated!") : _keyResult.Error)
                            </div>
                        }
                    </div>
                }

                <p class="text-sm text-muted">Sign packages with PGP keys to ensure authenticity and integrity.</p>
                <div class="mb-3">
                    <label class="form-label">Artifact ID</label>
                    <input type="text" class="form-control form-control-sm" @bind="_signArtifactId" placeholder="Enter artifact Guid" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Key ID</label>
                    <input type="text" class="form-control form-control-sm" @bind="_signKeyId" placeholder="Enter key Guid" />
                </div>
                <button class="btn btn-warning btn-sm" @onclick="SignPackage" disabled="@(_signing)">
                    @if (_signing)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Sign Package
                </button>
                @if (_signResult != null)
                {
                    <div class="alert @(string.IsNullOrEmpty(_signResult.Error) ? "alert-success" : "alert-danger") mt-3 animate-slide-in">
                        @(string.IsNullOrEmpty(_signResult.Error) ? _signResult.Message ?? "Package signed successfully" : _signResult.Error)
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Hash Records -->
    <div class="col-md-6">
        <div class="card animate-slide-in">
            <div class="card-header">
                <h3><Icon Name="hash" /> Hash Records</h3>
            </div>
            <div class="card-body p-0">
                @if (_hashes?.Data?.Hashes != null && _hashes.Data.Hashes.Any())
                {
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>Artifact</th>
                                <th>SHA256</th>
                                <th>MD5</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hash in _hashes.Data.Hashes.Take(20))
                            {
                                <tr>
                                    <td><code>@hash.ArtifactId.ToString()[..8]</code></td>
                                    <td>
                                        <code style="font-size:0.7em;" title="@hash.HashSha256">
                                            @hash.HashSha256?[..Math.Min(24, hash.HashSha256?.Length ?? 0)]...
                                        </code>
                                    </td>
                                    <td class="text-xs text-muted">@hash.HashMd5</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><Icon Name="hash" /></div>
                        <h3>No hash records</h3>
                        <p>Hashes are computed automatically after builds.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- CVE Scans -->
<div class="card mt-4 animate-slide-in">
    <div class="card-header">
        <h3><Icon Name="shield" /> CVE Scan Reports</h3>
        <span class="badge bg-secondary">@(_scans?.Data?.TotalCount ?? 0) scans</span>
    </div>
    <div class="card-body p-0">
        @if (_scans?.Data?.Scans != null && _scans.Data.Scans.Any())
        {
            <table class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Scan ID</th>
                        <th>Artifact</th>
                        <th>Scanner</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Critical</th>
                        <th>High</th>
                        <th>Started</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var scan in _scans.Data.Scans)
                    {
                        <tr>
                            <td><code>@scan.Id.ToString()[..8]</code></td>
                            <td><code>@scan.ArtifactId.ToString()[..8]</code></td>
                            <td class="text-sm">@scan.ScannerType</td>
                            <td>
                                <span class="badge @GetScanBadge(scan)">
                                    <span class="badge-dot @GetScanDot(scan)"></span>
                                    @GetScanStatusLabel(scan)
                                </span>
                            </td>
                            <td><strong>@scan.TotalVulnerabilities</strong></td>
                            <td class="@(scan.CriticalCount > 0 ? "text-danger" : "text-muted")"><strong>@scan.CriticalCount</strong></td>
                            <td class="@(scan.HighCount > 0 ? "text-warning" : "text-muted")"><strong>@scan.HighCount</strong></td>
                            <td class="text-sm text-muted">@scan.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><Icon Name="shield" /></div>
                <h3>No CVE scans yet</h3>
                <p>Artifacts are scanned automatically after build.</p>
            </div>
        }
    </div>
</div>

@code {
    private ApiResponse<HashListResponse>? _hashes;
    private ApiResponse<ScanPaginatedResponse>? _scans;
    private ApiResponse<object>? _signResult;
    private bool _signing = false;
    private string _signArtifactId = "";
    private string _signKeyId = "";

    // Key generation
    private bool _showGenerateKey = false;
    private bool _generatingKey = false;
    private string _keyName = "lumina-build";
    private string _keyEmail = "build@lumina-ci.local";
    private string _keyPassphrase = "";
    private ApiResponse<object>? _keyResult;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAll();
    }

    private async Task RefreshAll()
    {
        try { await Task.WhenAll(LoadHashes(), LoadScans()); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load security data"); }
    }

    private async Task LoadHashes() => _hashes = await Api.GetHashRecordsAsync(1);
    private async Task LoadScans() => _scans = await Api.GetScansAsync(1);

    private async Task SignPackage()
    {
        if (!Guid.TryParse(_signArtifactId, out var artifactId) || !Guid.TryParse(_signKeyId, out var keyId)) return;
        _signing = true;
        try
        {
            _signResult = await Api.SignPackageAsync(new SignPackageRequest(artifactId, keyId));
            await LoadHashes();
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to sign package"); }
        finally { _signing = false; }
    }

    private static string GetScanBadge(ScanSummaryResponse scan) => scan.Status switch
    {
        Lumina.Shared.Models.Enums.ScanStatus.Completed when scan.CriticalCount > 0 => "bg-danger",
        Lumina.Shared.Models.Enums.ScanStatus.Completed when scan.TotalVulnerabilities > 0 => "bg-warning",
        Lumina.Shared.Models.Enums.ScanStatus.Completed => "bg-success",
        Lumina.Shared.Models.Enums.ScanStatus.Running => "bg-primary",
        Lumina.Shared.Models.Enums.ScanStatus.Failed => "bg-danger",
        _ => "bg-warning"
    };

    private void ToggleGenerateKey() => _showGenerateKey = !_showGenerateKey;

    private async Task GenerateKey()
    {
        _generatingKey = true;
        _keyResult = null;
        try
        {
            _keyResult = await Api.GenerateKeyAsync(_keyName, _keyEmail, _keyPassphrase);
            if (_keyResult?.Success == true)
            {
                _showGenerateKey = false;
                _keyName = "lumina-build";
                _keyEmail = "build@lumina-ci.local";
                _keyPassphrase = "";
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to generate key"); }
        finally { _generatingKey = false; }
    }

    private static string GetScanDot(ScanSummaryResponse scan) => scan.Status switch
    {
        Lumina.Shared.Models.Enums.ScanStatus.Completed when scan.CriticalCount > 0 => "red",
        Lumina.Shared.Models.Enums.ScanStatus.Completed when scan.TotalVulnerabilities > 0 => "yellow",
        Lumina.Shared.Models.Enums.ScanStatus.Completed => "green",
        Lumina.Shared.Models.Enums.ScanStatus.Running => "blue",
        Lumina.Shared.Models.Enums.ScanStatus.Failed => "red",
        _ => "yellow"
    };

    private static string GetScanStatusLabel(ScanSummaryResponse scan) => scan.Status switch
    {
        Lumina.Shared.Models.Enums.ScanStatus.Completed when scan.TotalVulnerabilities > 0 => "Findings",
        Lumina.Shared.Models.Enums.ScanStatus.Completed => "Clean",
        _ => scan.Status.ToString()
    };
}
