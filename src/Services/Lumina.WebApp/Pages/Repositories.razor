@page "/repositories"
@using Lumina.Shared.DTOs
@inject Lumina.WebApp.Services.LuminaApiService Api
@inject ILogger<Repositories> Logger

<PageTitle>Repositories — Lumina CI</PageTitle>

<div class="page-header">
    <h1>Repositories</h1>
    <div class="page-header-actions">
        <button class="btn btn-primary" @onclick="() => _showCreate = true">+ New Repository</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadRepos">Refresh</button>
    </div>
</div>

@if (_showCreate)
{
    <div class="card mb-4 animate-slide-in">
        <div class="card-header">
            <h4 class="mb-0">+ Create Repository</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" @bind="_newName" placeholder="el9-baseos" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Display Name</label>
                    <input type="text" class="form-control" @bind="_newDisplayName" placeholder="Enterprise Linux 9 BaseOS" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Base Path</label>
                    <input type="text" class="form-control" @bind="_newBasePath" placeholder="/el/9/baseos" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Architecture</label>
                    <select class="form-select" @bind="_newArch">
                        <option value="x86_64">x86_64</option>
                        <option value="aarch64">aarch64</option>
                        <option value="noarch">noarch</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Distribution</label>
                    <input type="text" class="form-control" @bind="_newDist" placeholder="el9" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="CreateRepo">Create</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_alertMessage != null)
{
    <div class="alert @_alertClass alert-dismissible fade show animate-slide-in">
        @_alertMessage
        <button type="button" class="btn-close" @onclick="() => _alertMessage = null"></button>
    </div>
}

@if (_loading)
{
    <div class="card"><div class="card-body p-4">
        <div class="skeleton skeleton-card"></div>
        <div class="skeleton skeleton-card"></div>
    </div></div>
}
else if (_repos?.Data?.Repositories != null && _repos.Data.Repositories.Any())
{
    <div class="section-title">@(_repos.Data.Repositories.Count()) Repositories</div>
    <div class="row">
        @foreach (var repo in _repos.Data.Repositories)
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card repo-card animate-slide-in h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@repo.DisplayName</h5>
                        <span class="badge @(repo.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot @(repo.IsActive ? "green" : "")"></span>
                            @(repo.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <code style="font-size:0.85em;background:rgba(255,255,255,0.05);padding:2px 6px;border-radius:3px;">@repo.BasePath</code>
                        </div>
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Architecture</span>
                            <strong class="text-bright">@repo.Arch</strong>
                        </div>
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Packages</span>
                            <strong class="text-bright">@repo.PackageCount</strong>
                        </div>
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Distribution</span>
                            <span>@repo.Distribution</span>
                        </div>
                        <hr style="border-color:var(--border-light);" />
                        <div class="d-flex gap-2 mb-2">
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => StartUpload(repo.Id)" title="Upload RPM package">
                                Upload
                            </button>
                            <button class="btn btn-sm btn-outline-success flex-fill" @onclick="() => SyncRepo(repo.Id)" title="Sync repository metadata">
                                Sync
                            </button>
                        </div>
                        <div class="text-xs text-muted">
                            <code>packages.lumina.1t.ru@repo.BasePath</code>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state animate-slide-in">
        <div class="empty-state-icon"><span class="icon-inner"></span></div>
        <h3>No repositories</h3>
        <p>Create a repository to start publishing packages.</p>
    </div>
}

@* Upload Modal *@
@if (_showUpload && _uploadRepoId.HasValue)
{
    <div class="modal-overlay" @onclick="() => _showUpload = false">
        <div class="card modal-card" @onclick:stopPropagation="true" style="max-width:500px; width:90%;">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Upload RPM Package</h4>
                <button class="btn-close" @onclick="() => _showUpload = false"></button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Select RPM file</label>
                    <InputFile OnChange="HandleFileSelected" accept=".rpm" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Detached PGP signature (.asc) — required</label>
                    <InputFile OnChange="HandleSignatureSelected" accept=".asc" />
                    <small class="text-muted">Unsigned RPMs cannot be uploaded. The signature is verified against the active public key before publishing.</small>
                </div>
                @if (_selectedFileName != null)
                {
                    <div class="mb-3 text-sm">
                        <span class="text-muted">Selected:</span>
                        <strong class="text-bright">@_selectedFileName</strong>
                        @if (_selectedFileSize > 0)
                        {
                            <span class="text-muted">(@(_selectedFileSize / 1024) KB)</span>
                        }
                    </div>
                }
                @if (_uploading)
                {
                    <div class="mb-3">
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%">Uploading & verifying...</div>
                        </div>
                    </div>
                }
                <div class="d-flex gap-2">
                    <button class="btn btn-success" @onclick="DoUpload" disabled="@(_selectedFile == null || _selectedSignature == null || _uploading)">
                        @(_uploading ? "Uploading..." : "Upload & Verify")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => _showUpload = false" disabled="@_uploading">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ApiResponse<RepositoryListResponse>? _repos;
    private bool _loading = true;
    private bool _showCreate = false;
    private string _newName = "";
    private string _newDisplayName = "";
    private string _newBasePath = "";
    private string _newArch = "x86_64";
    private string _newDist = "";
    private string? _alertMessage;
    private string _alertClass = "alert-success";

    // Upload state
    private bool _showUpload = false;
    private Guid? _uploadRepoId;
    private IBrowserFile? _selectedFile;
    private IBrowserFile? _selectedSignature;
    private string? _selectedFileName;
    private long _selectedFileSize;
    private bool _uploading;

    protected override async Task OnInitializedAsync()
    {
        await LoadRepos();
    }

    private async Task LoadRepos()
    {
        try { _repos = await Api.GetRepositoriesAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load repositories"); }
        finally { _loading = false; }
    }

    private async Task CreateRepo()
    {
        try
        {
            var result = await Api.CreateRepositoryAsync(new CreateRepositoryRequest(
                _newName, _newDisplayName, _newBasePath, _newArch, _newDist, "admin"));
            if (result?.Success == true)
            {
                _showCreate = false;
                _newName = _newDisplayName = _newBasePath = _newDist = "";
                _alertMessage = "Repository created successfully!";
                _alertClass = "alert-success";
                _repos = await Api.GetRepositoriesAsync();
            }
            else
            {
                _alertMessage = $"Failed: {result?.Error ?? "Unknown error"}";
                _alertClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            _alertMessage = $"Error: {ex.Message}";
            _alertClass = "alert-danger";
            Logger.LogError(ex, "Failed to create repository");
        }
    }

    private void StartUpload(Guid repoId)
    {
        _uploadRepoId = repoId;
        _selectedFile = null;
        _selectedSignature = null;
        _selectedFileName = null;
        _selectedFileSize = 0;
        _uploading = false;
        _showUpload = true;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _selectedFileName = e.File.Name;
        _selectedFileSize = e.File.Size;
    }

    private void HandleSignatureSelected(InputFileChangeEventArgs e)
    {
        _selectedSignature = e.File;
    }

    private async Task DoUpload()
    {
        if (_selectedFile == null || _selectedSignature == null || !_uploadRepoId.HasValue) return;

        _uploading = true;
        try
        {
            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            using var sigStream = _selectedSignature.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await Api.UploadPackageAsync(_uploadRepoId.Value, stream, _selectedFile.Name, sigStream, _selectedSignature.Name, "web-upload");

            if (result?.Success == true)
            {
                _showUpload = false;
                _alertMessage = "Package uploaded and repository metadata updated!";
                _alertClass = "alert-success";
                _repos = await Api.GetRepositoriesAsync();
            }
            else
            {
                _alertMessage = $"Upload failed: {result?.Error ?? "Unknown error"}";
                _alertClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            _alertMessage = $"Upload error: {ex.Message}";
            _alertClass = "alert-danger";
            Logger.LogError(ex, "Failed to upload package");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SyncRepo(Guid repoId)
    {
        try
        {
            var result = await Api.SyncRepositoryAsync(repoId);
            if (result?.Success == true)
            {
                _alertMessage = "Repository metadata synced (createrepo_c --update)";
                _alertClass = "alert-success";
            }
            else
            {
                _alertMessage = $"Sync failed: {result?.Error ?? "Unknown error"}";
                _alertClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            _alertMessage = $"Sync error: {ex.Message}";
            _alertClass = "alert-danger";
            Logger.LogError(ex, "Failed to sync repository");
        }
    }
}
