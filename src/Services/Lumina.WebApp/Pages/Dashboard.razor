@page "/"
@using Lumina.Shared.DTOs
@using Lumina.Shared.Models.Enums
@inject Lumina.WebApp.Services.LuminaApiService Api
@inject ILogger<Dashboard> Logger
@inject NavigationManager Navigation

<PageTitle>Dashboard — Lumina CI</PageTitle>

<div class="page-header">
    <h1>Dashboard</h1>
    <div class="page-header-actions">
        <a href="/pipelines" class="btn btn-outline-success"><Icon Name="plus" /> New Build</a>
        <button class="btn btn-outline-secondary" @onclick="RefreshAll"><Icon Name="refresh" /> Refresh</button>
    </div>
</div>

<!-- Stats -->
<div class="stats-grid animate-slide-in">
    <div class="stat-card">
        <div class="stat-icon blue"><Icon Name="clock" /></div>
        <div class="stat-info">
            <div class="stat-value">@(_buildQueue?.Data?.QueuedCount ?? 0)</div>
            <div class="stat-label">In Queue</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon yellow"><Icon Name="loader" /></div>
        <div class="stat-info">
            <div class="stat-value">@(_buildQueue?.Data?.RunningCount ?? 0)</div>
            <div class="stat-label">Building</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><Icon Name="check-circle" /></div>
        <div class="stat-info">
            <div class="stat-value">@(_successCount)</div>
            <div class="stat-label">Completed</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red"><Icon Name="x-circle" /></div>
        <div class="stat-info">
            <div class="stat-value">@(_failedCount)</div>
            <div class="stat-label">Failed</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple"><Icon Name="gauge" /></div>
        <div class="stat-info">
            <div class="stat-value">@(_successRate)%</div>
            <div class="stat-label">Success Rate</div>
        </div>
    </div>
</div>

<!-- Build Trend Graph -->
@if (_builds?.Data?.Builds != null && _builds.Data.Builds.Any())
{
    <div class="card mb-4 animate-slide-in">
        <div class="card-header">
            <h3>Build Trend</h3>
            <span class="text-xs text-muted">Last @(_builds.Data.Builds.Take(20).Count()) builds</span>
        </div>
        <div class="card-body">
            <div class="build-health" style="height:40px;">
                @foreach (var build in _builds.Data.Builds.Take(20).Reverse())
                {
                    var height = build.Status == BuildStatus.Success ? 40 : build.Status == BuildStatus.Failed ? 40 : 25;
                    var css = build.Status switch
                    {
                        BuildStatus.Success => "success",
                        BuildStatus.Failed => "failed",
                        BuildStatus.Building => "running",
                        _ => "queued"
                    };
                    <div class="health-bar @css" style="height:@(height)px;" title="@build.SpecName — @build.Status (@build.CreatedAt.ToLocalTime().ToString("g"))"></div>
                }
            </div>
            <div class="d-flex justify-content-between mt-2">
                <span class="text-xs text-muted">Oldest</span>
                <span class="text-xs text-muted">Newest</span>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Executors -->
    <div class="col-md-8">
        <div class="card animate-slide-in">
            <div class="card-header">
                <h3>Executors</h3>
                <span class="text-xs text-muted">@(_buildQueue?.Data?.RunningCount ?? 0) running</span>
            </div>
            <div class="card-body">
                @if (_buildQueue?.Data?.Running != null && _buildQueue.Data.Running.Any())
                {
                    foreach (var b in _buildQueue.Data.Running)
                    {
                        <div class="queue-item running building-pulse">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <strong class="text-bright">@b.SpecName</strong>
                                </div>
                                <div class="text-xs text-muted mt-1">
                                    Started @b.CreatedAt.ToLocalTime().ToString("HH:mm:ss")
                                    <span class="ms-2">@GetElapsedTime(b.CreatedAt)</span>
                                </div>
                            </div>
                            <a href="/builds/@b.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center p-4 text-muted">
                        <div class="empty-state-icon" style="width:48px;height:48px;font-size:1.3rem;margin-bottom:8px;">
                            <Icon Name="check-circle" />
                        </div>
                        <div>No builds running</div>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Builds -->
        <div class="card animate-slide-in">
            <div class="card-header">
                <h3>Build History</h3>
                <a href="/builds" class="text-xs">View all <Icon Name="chevron-right" /></a>
            </div>
            <div class="card-body p-0">
                @if (_builds?.Data?.Builds != null && _builds.Data.Builds.Any())
                {
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th style="width:6px;padding:0;"></th>
                                <th>Build</th>
                                <th>Status</th>
                                <th>Triggered By</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var build in _builds.Data.Builds.Take(15))
                            {
                                var statusColor = build.Status switch
                                {
                                    BuildStatus.Success => "var(--accent-green)",
                                    BuildStatus.Failed => "var(--accent-red)",
                                    BuildStatus.Building => "var(--accent)",
                                    BuildStatus.Queued => "var(--accent-yellow)",
                                    _ => "var(--text-primary)"
                                };
                                <tr class="clickable-row"
                                    role="link"
                                    tabindex="0"
                                    aria-label="View build @build.Id"
                                    @onclick="() => NavigateToBuild(build.Id)"
                                    @onkeydown="args => HandleBuildRowKeyDown(args, build.Id)">
                                    <td style="width:6px;padding:0;background:@statusColor;border-radius:3px;"></td>
                                    <td>
                                        <code>@build.Id.ToString()[..8]</code>
                                        <div class="text-xs text-muted">@build.SpecName</div>
                                    </td>
                                    <td>
                                        @if (build.Status == BuildStatus.Building)
                                        {
                                            <span class="badge bg-primary building-pulse">
                                                <span class="badge-dot blue"></span> Building
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="@GetStatusBadgeClass(build.Status)">@build.Status</span>
                                        }
                                    </td>
                                    <td class="text-sm">@build.TriggeredBy</td>
                                    <td class="text-sm text-muted">@build.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><span class="icon-inner"></span></div>
                        <h3>No builds yet</h3>
                        <p>Create a pipeline and trigger a build to get started.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Build Queue -->
    <div class="col-md-4">
        <div class="card animate-slide-in">
            <div class="card-header">
                <h3>Build Queue</h3>
                <span class="badge bg-warning">@(_buildQueue?.Data?.QueuedCount ?? 0)</span>
            </div>
            <div class="card-body">
                @if (_buildQueue?.Data != null)
                {
                    if (_buildQueue.Data.Running.Any())
                    {
                        <div class="section-title">Running</div>
                        foreach (var b in _buildQueue.Data.Running)
                        {
                            <div class="queue-item running">
                                <div>
                                    <strong class="text-bright">@b.SpecName</strong>
                                    <div class="text-xs text-muted">started @b.CreatedAt.ToLocalTime().ToString("t")</div>
                                </div>
                                <a href="/builds/@b.Id" class="btn btn-sm btn-outline-primary">View</a>
                            </div>
                        }
                    }
                    if (_buildQueue.Data.Queued.Any())
                    {
                        <div class="section-title mt-3">Queued</div>
                        foreach (var b in _buildQueue.Data.Queued)
                        {
                            <div class="queue-item queued">
                                <div>
                                    <strong class="text-bright">@b.SpecName</strong>
                                    <div class="text-xs text-muted">queued @b.CreatedAt.ToLocalTime().ToString("t")</div>
                                </div>
                                <a href="/builds/@b.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </div>
                        }
                    }
                    if (!_buildQueue.Data.Queued.Any() && !_buildQueue.Data.Running.Any())
                    {
                        <div class="text-center p-3 text-muted">
                            <span class="status-dot success"></span>
                            <div class="text-sm mt-2">Queue is empty</div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="card animate-slide-in">
            <div class="card-header">
                <h3>Statistics</h3>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-sm">Total Builds</span>
                    <strong class="text-bright">@(_builds?.Data?.TotalCount ?? 0)</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-sm">Successful</span>
                    <strong class="text-success">@_successCount</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-sm">Failed</span>
                    <strong class="text-danger">@_failedCount</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-sm">Success Rate</span>
                    <strong class="text-bright">@_successRate%</strong>
                </div>
                <div class="progress mt-2" style="height:8px;">
                    <div class="progress-bar bg-success" style="width:@_successRate%"></div>
                    <div class="progress-bar bg-danger" style="width:@(100 - _successRate)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ApiResponse<BuildListResponse>? _builds;
    private ApiResponse<BuildQueueResponse>? _buildQueue;
    private int _successCount = 0;
    private int _failedCount = 0;
    private int _successRate = 0;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAll();
    }

    private async Task RefreshAll()
    {
        try
        {
            await Task.WhenAll(LoadBuildsAsync(), LoadQueueAsync());
            ComputeStats();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard data");
        }
    }

    private async Task LoadBuildsAsync() => _builds = await Api.GetBuildsAsync(1, 30);
    private async Task LoadQueueAsync() => _buildQueue = await Api.GetBuildQueueAsync();

    private void ComputeStats()
    {
        if (_builds?.Data?.Builds == null) return;
        _successCount = _builds.Data.Builds.Count(b => b.Status == BuildStatus.Success);
        _failedCount = _builds.Data.Builds.Count(b => b.Status == BuildStatus.Failed);
        var total = _successCount + _failedCount;
        _successRate = total > 0 ? (int)Math.Round((double)_successCount / total * 100) : 0;
    }

    private string GetElapsedTime(DateTime createdAt)
    {
        var elapsed = DateTime.UtcNow - createdAt;
        if (elapsed.TotalMinutes < 1) return $"{(int)elapsed.TotalSeconds}s";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes}m {(int)elapsed.Seconds}s";
        return $"{(int)elapsed.TotalHours}h {(int)elapsed.Minutes}m";
    }

    private void NavigateToBuild(Guid buildId) => Navigation.NavigateTo($"/builds/{buildId}");

    private void HandleBuildRowKeyDown(KeyboardEventArgs args, Guid buildId)
    {
        if (args.Key == "Enter")
        {
            NavigateToBuild(buildId);
        }
    }

    private string GetStatusBadgeClass(BuildStatus status) => status switch
    {
        BuildStatus.Queued => "badge bg-warning",
        BuildStatus.Building => "badge bg-primary",
        BuildStatus.Success => "badge bg-success",
        BuildStatus.Failed => "badge bg-danger",
        BuildStatus.Cancelled => "badge bg-secondary",
        _ => "badge bg-secondary"
    };
}
