@page "/builds/{id:guid}"
@using Lumina.Shared.DTOs
@using Lumina.Shared.Models.Enums
@implements IDisposable
@inject Lumina.WebApp.Services.LuminaApiService Api
@inject ILogger<BuildDetail> Logger
@inject NavigationManager Nav

<PageTitle>Build @Id — Lumina CI</PageTitle>

<div class="page-header">
    <h1>
        <a href="/builds" class="text-decoration-none text-muted">Builds</a>
        <span class="mx-2 text-muted" style="font-weight:300;">/</span>
        <code style="font-size:0.85em">@Id.ToString()[..8]</code>
    </h1>
    <div class="page-header-actions">
        @if (_build?.Data != null)
        {
            var isRunning = _build.Data.Status == BuildStatus.Building || _build.Data.Status == BuildStatus.Queued;
            @if (isRunning)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="CancelBuild" disabled="@_cancelling">
                    @if (_cancelling)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Cancelling...</span>
                    }
                    else
                    {
                        <Icon Name="cancel" /> <span>Cancel</span>
                    }
                </button>
            }
            @if (_build.Data.Artifacts.Any())
            {
                <button class="btn btn-outline-success btn-sm" @onclick="DownloadAllArtifacts"><Icon Name="download" /> Download RPM</button>
            }
            <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadSpec"><Icon Name="file-code" /> Spec</button>
        }
        <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack"><Icon Name="chevron-left" /> Back</button>
    </div>
</div>

@if (_loading)
{
    <div class="card"><div class="card-body p-4">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text"></div>
        <div class="skeleton skeleton-text" style="width:70%"></div>
    </div></div>
}
else if (_loadError != null)
{
    <div class="alert alert-danger" role="alert">@_loadError</div>
}
else if (_build?.Data == null)
{
    <div class="alert alert-danger">Build not found.</div>
}
else
{
    var build = _build.Data;
    var isRunning = build.Status == BuildStatus.Building || build.Status == BuildStatus.Queued;

    <!-- Status Banner -->
    <div class="card mb-4 @GetStatusBorderClass(build.Status) animate-slide-in">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @if (build.Status == BuildStatus.Building)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span class="@GetStatusDotClass(build.Status)"></span>
                        }
                        <h3 class="mb-0 @GetStatusTextClass(build.Status)">@build.Status</h3>
                        @if (isRunning)
                        {
                            <span class="badge bg-primary building-pulse">
                                <span class="spinner-border spinner-border-sm" style="width:10px;height:10px;border-width:1px;"></span>
                                Live
                            </span>
                        }
                    </div>
                    <table class="table table-sm" role="presentation" style="border-collapse:collapse;">
                        <tr style="border:none;">
                            <td class="text-muted text-sm" style="width:130px;border:none;padding:4px 8px;">Spec Name:</td>
                            <td style="border:none;padding:4px 8px;"><strong class="text-bright">@build.SpecName</strong></td>
                        </tr>
                        <tr style="border:none;">
                            <td class="text-muted text-sm" style="border:none;padding:4px 8px;">Pipeline:</td>
                            <td style="border:none;padding:4px 8px;"><a href="/builds" class="text-sm"><code>@build.PipelineId.ToString()[..8]...</code></a></td>
                        </tr>
                        <tr style="border:none;">
                            <td class="text-muted text-sm" style="border:none;padding:4px 8px;">Triggered By:</td>
                            <td style="border:none;padding:4px 8px;">@build.TriggeredBy</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(build.CommitSha))
                        {
                            <tr style="border:none;">
                                <td class="text-muted text-sm" style="width:130px;border:none;padding:4px 8px;">Commit:</td>
                                <td style="border:none;padding:4px 8px;">
                                    <span class="badge bg-info me-1">Git</span>
                                    <code style="font-size:0.85em;">@build.CommitSha</code>
                                    @if (!string.IsNullOrEmpty(build.Branch))
                                    {
                                        <span class="badge bg-secondary ms-2">@build.Branch</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(build.CommitMessage))
                        {
                            <tr style="border:none;">
                                <td class="text-muted text-sm" style="width:130px;border:none;padding:4px 8px;">Message:</td>
                                <td style="border:none;padding:4px 8px;">
                                    <em class="text-sm">@build.CommitMessage</em>
                                </td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(build.CommitAuthor))
                        {
                            <tr style="border:none;">
                                <td class="text-muted text-sm" style="width:130px;border:none;padding:4px 8px;">Author:</td>
                                <td style="border:none;padding:4px 8px;">
                                    @build.CommitAuthor
                                </td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(build.SourceUrl))
                        {
                            <tr style="border:none;">
                                <td class="text-muted text-sm" style="width:130px;border:none;padding:4px 8px;">Source URL:</td>
                                <td style="border:none;padding:4px 8px;">
                                    @if (build.SourceUrl.StartsWith("git://"))
                                    {
                                        <span class="badge bg-info me-1">Git</span>
                                        <code style="font-size:0.8em;">@build.SourceUrl</code>
                                    }
                                    else
                                    {
                                        <a href="@build.SourceUrl" target="_blank" rel="noopener noreferrer" class="text-break text-sm">@build.SourceUrl</a>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(build.ContainerId))
                        {
                            <tr style="border:none;">
                                <td class="text-muted text-sm" style="width:130px;border:none;padding:4px 8px;">Container:</td>
                                <td style="border:none;padding:4px 8px;"><code style="font-size:0.75em;">@build.ContainerId.ToString()[..16]...</code></td>
                            </tr>
                        }
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-sm" role="presentation" style="border-collapse:collapse;">
                        <tr style="border:none;">
                            <td class="text-muted text-sm" style="width:130px;border:none;padding:4px 8px;">Created:</td>
                            <td style="border:none;padding:4px 8px;">@build.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                        @if (build.StartedAt.HasValue)
                        {
                            <tr style="border:none;">
                                <td class="text-muted text-sm" style="border:none;padding:4px 8px;">Started:</td>
                                <td style="border:none;padding:4px 8px;">@build.StartedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                        @if (build.CompletedAt.HasValue)
                        {
                            <tr style="border:none;">
                                <td class="text-muted text-sm" style="border:none;padding:4px 8px;">Completed:</td>
                                <td style="border:none;padding:4px 8px;">@build.CompletedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                        <tr style="border:none;">
                            <td class="text-muted text-sm" style="border:none;padding:4px 8px;">Duration:</td>
                            <td style="border:none;padding:4px 8px;">
                                @if (build.CompletedAt.HasValue && build.StartedAt.HasValue)
                                {
                                    <strong class="text-bright">@((build.CompletedAt.Value - build.StartedAt)?.ToString(@"mm\:ss"))</strong>
                                }
                                else if (build.StartedAt.HasValue)
                                {
                                    <span class="text-warning building-pulse">@((DateTime.UtcNow - build.StartedAt.Value).ToString(@"mm\:ss"))</span>
                                    <span class="text-xs text-muted ms-2">(running)</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Pipeline Stage View -->
    <div class="section-title">Pipeline Stages</div>
    <div class="pipeline-stages animate-slide-in">
        @foreach (var stage in GetStages(build))
        {
            <div class="stage-item @stage.CssClass">
                <div class="stage-icon"><span class="@stage.DotClass"></span></div>
                <div class="stage-name">@stage.Name</div>
                <div class="stage-status @stage.TextClass">@stage.Status</div>
            </div>
            @if (stage != GetStages(build).Last())
            {
                <div class="stage-connector"><Icon Name="chevron-right" /></div>
            }
        }
    </div>

    <!-- Artifacts -->
    @if (build.Artifacts.Any())
    {
        <div class="section-title mt-4">Artifacts</div>
        <div class="card animate-slide-in">
            <div class="table-responsive">
                <table class="table table-hover">
                    <caption class="visually-hidden">Build artifacts</caption>
                    <thead>
                        <tr>
                            <th scope="col">Artifact ID</th>
                            <th scope="col">File Name</th>
                            <th scope="col">Size</th>
                            <th scope="col">SHA256</th>
                            <th scope="col">Signature</th>
                            <th scope="col">CVE Scan</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var artifact in build.Artifacts)
                        {
                            <tr>
                                <td><code style="font-size:0.75em;" title="@artifact.Id.ToString()">@artifact.Id.ToString()[..8]...</code></td>
                                <td><strong class="text-bright">@artifact.FileName</strong></td>
                                <td class="text-sm">@FormatFileSize(artifact.FileSize)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(artifact.HashSha256))
                                    {
                                        <code style="font-size:0.7em;word-break:break-all;">@artifact.HashSha256</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(artifact.SigningKeyFingerprint))
                                    {
                                        <span class="badge bg-success">SIGNED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">NOT SIGNED</span>
                                    }
                                </td>
                                <td>
                                    <span class="@GetScanBadge(artifact.CveScanStatus)">@artifact.CveScanStatus</span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => DownloadArtifact(artifact.FileName)" title="Download @artifact.FileName"><Icon Name="download" /> Download</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Publish to Repository -->
    @if (build.Status == BuildStatus.Success && build.Artifacts.Any())
    {
        <div class="section-title mt-4">Publish to Repository</div>
        <div class="card animate-slide-in">
            <div class="card-body">
                @if (build.Artifacts.All(artifact => artifact.PublishedAt.HasValue))
                {
                    <div class="alert alert-success mb-0" role="status">
                        All artifacts were published automatically by the pipeline.
                    </div>
                }
                else if (_publishMessage != null)
                {
                    <div class="alert @(_publishSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 px-3 mb-3" role="status" aria-live="polite">
                        @_publishMessage
                        <button type="button" class="btn-close btn-sm" @onclick="() => _publishMessage = null" aria-label="Dismiss publish message" style="font-size:0.6em;"></button>
                    </div>
                }
                @if (build.Artifacts.Any(artifact => !artifact.PublishedAt.HasValue) && _reposLoadError != null)
                {
                    <div class="alert alert-danger py-2 px-3 mb-2" role="alert">
                        @_reposLoadError
                    </div>
                }
                else if (build.Artifacts.Any(artifact => !artifact.PublishedAt.HasValue) &&
                         (_repos?.Data?.Repositories == null || !_repos.Data.Repositories.Any()))
                {
                    <div class="text-muted text-sm mb-2">
                        No repositories available. <a href="/repositories">Create one first</a>.
                    </div>
                }
                else if (build.Artifacts.Any(artifact => !artifact.PublishedAt.HasValue))
                {
                    <div class="row align-items-end">
                        <div class="col-md-5 mb-2">
                            <label class="form-label text-sm" for="publish-repository">Repository</label>
                            <select id="publish-repository" class="form-select form-select-sm" @bind="_selectedRepoId">
                                <option value="">-- Select repository --</option>
                                @foreach (var repo in _repos?.Data?.Repositories ?? [])
                                {
                                    <option value="@repo.Id">@repo.DisplayName (@repo.Arch)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5 mb-2">
                            <label class="form-label text-sm" for="publish-artifact">Artifact</label>
                            <select id="publish-artifact" class="form-select form-select-sm" @bind="_selectedArtifactId">
                                @foreach (var artifact in build.Artifacts.Where(artifact => !artifact.PublishedAt.HasValue))
                                {
                                    <option value="@artifact.Id">@artifact.FileName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <button class="btn btn-sm btn-success w-100" @onclick="PublishArtifact" disabled="@(!_selectedRepoId.HasValue || _publishing || SelectedArtifactUnsigned)">
                                @if (_publishing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Publishing...</span>
                                }
                                else
                                {
                                    <span>Publish</span>
                                }
                            </button>
                        </div>
                    </div>
                    @if (SelectedArtifactUnsigned)
                    {
                        <div class="alert alert-danger py-2 px-3 mt-2 mb-0">
                            <strong>Artifact is not signed</strong> — publish is blocked. Generate an active PGP key and ensure the Sign stage completed, then re-run the build.
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- Console Output -->
    <div class="section-title mt-4">Console Output</div>
    <div class="console-output animate-slide-in">
        <div class="console-header">
            <span><Icon Name="terminal" /> Build Logs</span>
            <div class="d-flex align-items-center gap-2">
                @if (isRunning)
                {
                    <span class="badge @GetStreamBadgeClass()" role="status">
                        @if (_streamState is LogStreamState.Connecting or LogStreamState.Reconnecting)
                        {
                            <span class="spinner-border spinner-border-sm" style="width:12px;height:12px;border-width:1px;"></span>
                        }
                        @GetStreamStateText()
                    </span>
                }
                @if (_logLines.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-secondary console-action" @onclick="DownloadLogs">
                        <Icon Name="download" /> Download
                    </button>
                    <button class="btn btn-sm btn-outline-secondary console-action" @onclick="CopyLogs">
                        <Icon Name="copy" /> @(_logsCopied ? "Copied" : "Copy")
                    </button>
                }
            </div>
        </div>
        @if (_logLines.Count > 0)
        {
            <div class="console-toolbar">
                <label class="visually-hidden" for="build-log-search">Search build logs</label>
                <input id="build-log-search"
                       class="form-control form-control-sm"
                       type="search"
                       placeholder="Search logs"
                       @bind="_logSearch"
                       @bind:event="oninput" />
                <label class="console-follow" for="follow-build-logs">
                    <input id="follow-build-logs" type="checkbox" @bind="_followTail" />
                    Follow tail
                </label>
                <span class="text-muted">@FilteredLogLines.Count / @_logLines.Count lines</span>
            </div>
        }
        <div class="console-body" id="console-body">
            @if (_logLines.Count == 0)
            {
                @if (isRunning)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        <span class="text-muted">Waiting for output...</span>
                    </div>
                }
                else
                {
                    <div class="text-center p-4 text-muted">No logs available.</div>
                }
            }
            else
            {
                @if (_droppedLogLineCount > 0)
                {
                    <div class="console-truncated" role="status">
                        @_droppedLogLineCount older lines omitted. Download the log for the complete retained output.
                    </div>
                }
                <Virtualize TItem="string" Items="@FilteredLogLines" Context="line" ItemSize="22" OverscanCount="10">
                    <span class="console-line @GetLineClass(line)">@line</span>
                </Virtualize>
            }
        </div>
        <div class="visually-hidden" aria-live="polite">@_logActionMessage</div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ApiResponse<BuildJobResponse>? _build;
    private bool _loading = true;
    private bool _cancelling = false;
    private string? _loadError;
    private const int MaxRetainedLogLines = 5_000;
    private readonly System.Collections.Concurrent.ConcurrentQueue<string> _pendingLogLines = new();
    private LogStreamState _streamState = LogStreamState.Disconnected;
    private Timer? _statusTimer;
    private Timer? _logFlushTimer;
    private DotNetObjectReference<BuildDetail>? _dotNetRef;

    // Log state
    private List<string> _logLines = new();
    private string _logSearch = string.Empty;
    private bool _followTail = true;
    private bool _logsCopied;
    private string _logActionMessage = string.Empty;
    private int _droppedLogLineCount;

    private List<string> FilteredLogLines =>
        string.IsNullOrWhiteSpace(_logSearch)
            ? _logLines
            : _logLines
                .Where(line => line.Contains(_logSearch, StringComparison.OrdinalIgnoreCase))
                .ToList();

    // Publish state
    private ApiResponse<RepositoryListResponse>? _repos;
    private string? _reposLoadError;
    private Guid? _selectedRepoId;
    private Guid? _selectedArtifactId;
    private bool _publishing = false;
    private string? _publishMessage;
    private bool _publishSuccess;

    // True when the currently-selected artifact has no PGP signature. The
    // server-side publish gate is authoritative; this just gives early UX
    // feedback (disables Publish, shows a warning) before the round-trip.
    private bool SelectedArtifactUnsigned =>
        _selectedArtifactId.HasValue
        && _build?.Data?.Artifacts != null
        && _build.Data.Artifacts.FirstOrDefault(a => a.Id == _selectedArtifactId.Value) is { } sel
        && string.IsNullOrEmpty(sel.SigningKeyFingerprint);

    protected override async Task OnInitializedAsync()
    {
        await LoadBuild();
        StartStreamingIfRunning();
    }

    private void StartStreamingIfRunning()
    {
        var isRunning = _build?.Data?.Status == BuildStatus.Building ||
                        _build?.Data?.Status == BuildStatus.Queued;

        if (!isRunning) return;

        // Connect SSE for real-time log streaming
        _dotNetRef = DotNetObjectReference.Create(this);
        _streamState = LogStreamState.Connecting;
        _logLines.Clear();
        _droppedLogLineCount = 0;
        _logFlushTimer = new Timer(
            _ => _ = InvokeAsync(FlushPendingLogLinesAsync),
            null,
            TimeSpan.FromMilliseconds(200),
            TimeSpan.FromMilliseconds(200));
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            try
            {
                await JS.InvokeVoidAsync("connectBuildLogStream", Id.ToString(), _dotNetRef);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to connect SSE stream for build {BuildId}", Id);
                _streamState = LogStreamState.Disconnected;
                await InvokeAsync(StateHasChanged);
            }
        });

        // Slow status polling (every 5 seconds) to refresh build metadata (status, artifacts, duration)
        _statusTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadBuild();
                StateHasChanged();

                var status = _build?.Data?.Status;
                if (status != BuildStatus.Building && status != BuildStatus.Queued)
                {
                    StopStreaming();
                }
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    [JSInvokable]
    public void OnLogLine(string line)
    {
        _pendingLogLines.Enqueue(line);
    }

    [JSInvokable]
    public Task OnStreamStateChanged(string state)
    {
        return InvokeAsync(() =>
        {
            _streamState = state switch
            {
                "live" => LogStreamState.Live,
                "reconnecting" => LogStreamState.Reconnecting,
                _ => LogStreamState.Disconnected
            };
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnStreamEnd()
    {
        InvokeAsync(async () =>
        {
            await FlushPendingLogLinesAsync();
            StopStreaming();
            // Final refresh to get complete build state
            await LoadBuild();
            StateHasChanged();
        });
    }

    private void StopStreaming()
    {
        _streamState = LogStreamState.Disconnected;
        _statusTimer?.Dispose();
        _statusTimer = null;
        _logFlushTimer?.Dispose();
        _logFlushTimer = null;
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        try { JS.InvokeVoidAsync("disconnectBuildLogStream"); } catch { }
    }

    public void Dispose()
    {
        StopStreaming();
    }

    private async Task LoadBuild()
    {
        _loadError = null;
        try
        {
            _build = await Api.GetBuildAsync(Id);
            if (_build?.Data?.Artifacts.Any() == true && _selectedArtifactId == null)
                _selectedArtifactId = _build.Data.Artifacts.First().Id;
            // Load repositories for publish section
            if (_build?.Data?.Status == BuildStatus.Success)
            {
                try
                {
                    _repos ??= await Api.GetRepositoriesAsync();
                    _reposLoadError = null;
                }
                catch (Exception ex)
                {
                    _repos = null;
                    _reposLoadError = "Repositories could not be loaded; publishing is unavailable.";
                    Logger.LogWarning(ex, "Failed to load repositories for build {BuildId}", Id);
                }
            }

            // Update log lines from API data only when not streaming via SSE
            // (SSE delivers log lines in real-time, so don't overwrite them)
            if (_streamState == LogStreamState.Disconnected &&
                _build?.Data != null &&
                !string.IsNullOrEmpty(_build.Data.Logs))
            {
                _logLines = CleanLogs(_build.Data.Logs);
            }
        }
        catch (Exception ex)
        {
            _build = null;
            _loadError = ex is Lumina.WebApp.Services.ApiRequestException apiEx
                ? apiEx.StatusCode switch
                {
                    System.Net.HttpStatusCode.NotFound => null,
                    System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please sign in again.",
                    _ => "Build details could not be loaded. Please retry."
                }
                : "Build details could not be loaded. Please retry.";
            Logger.LogError(ex, "Failed to load build {BuildId}", Id);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CancelBuild()
    {
        _cancelling = true;
        StateHasChanged();
        try
        {
            var result = await Api.CancelBuildAsync(Id);
            if (result?.Success == true)
            {
                StopStreaming();
                await LoadBuild();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel build {BuildId}", Id);
        }
        finally
        {
            _cancelling = false;
            StateHasChanged();
        }
    }

    private async Task PublishArtifact()
    {
        if (!_selectedRepoId.HasValue || !_selectedArtifactId.HasValue) return;
        _publishing = true; StateHasChanged();
        try
        {
            var result = await Api.PublishPackageAsync(_selectedArtifactId.Value, _selectedRepoId.Value, "admin");
            _publishSuccess = result?.Success == true;
            _publishMessage = _publishSuccess
                ? "Published to repository successfully!"
                : $"Publish failed: {result?.Error ?? "Unknown error"}";
        }
        catch (Exception ex)
        {
            _publishSuccess = false;
            _publishMessage = $"Error: {ex.Message}";
        }
        finally { _publishing = false; StateHasChanged(); }
    }

    private void GoBack() => Nav.NavigateTo("/builds");

    private record StageInfo(string Name, string DotClass, string Status, string CssClass, string TextClass);

    private List<StageInfo> GetStages(BuildJobResponse build)
    {
        if (build.StepRuns is not { Count: > 0 })
        {
            return
            [
                new StageInfo(
                    "Legacy build",
                    build.Status == BuildStatus.Success ? "status-dot success" :
                    build.Status == BuildStatus.Failed ? "status-dot failed" : "status-dot running",
                    build.Status.ToString(),
                    build.Status == BuildStatus.Success ? "stage-success" :
                    build.Status == BuildStatus.Failed ? "stage-failed" : "stage-running",
                    build.Status == BuildStatus.Failed ? "text-danger" : "text-primary")
            ];
        }

        return build.StepRuns
            .OrderBy(step => step.Order)
            .Select(step => step.Status switch
            {
                StepStatus.Success => new StageInfo(
                    step.Name, "status-dot success", "Completed", "stage-success", "text-success"),
                StepStatus.Running => new StageInfo(
                    step.Name, "status-dot running", "Running...", "stage-running", "text-primary"),
                StepStatus.Failed => new StageInfo(
                    step.Name, "status-dot failed", step.Error ?? "Failed", "stage-failed", "text-danger"),
                StepStatus.Skipped => new StageInfo(
                    step.Name, "status-dot pending", "Skipped", "stage-skipped", "text-muted"),
                _ => new StageInfo(
                    step.Name, "status-dot pending", "Pending", "stage-pending", "text-muted")
            })
            .ToList();
    }

    private List<string> CleanLogs(string logs)
    {
        var result = new List<string>(MaxRetainedLogLines);
        var lines = logs.Split('\n');
        var start = Math.Max(0, lines.Length - MaxRetainedLogLines);
        _droppedLogLineCount = start;
        for (var index = start; index < lines.Length; index++)
        {
            var line = lines[index];
            var cleaned = new string(line.Where(c => !char.IsControl(c) || c == '\t').ToArray());
            if (!string.IsNullOrWhiteSpace(cleaned))
                result.Add(cleaned);
        }
        return result;
    }

    private string GetLineClass(string line)
    {
        var lower = line.ToLowerInvariant();
        if (lower.Contains("error") || lower.Contains("failed") || lower.Contains("fatal")) return "line-error";
        if (lower.Contains("warning") || lower.Contains("warn")) return "line-warning";
        if (lower.Contains("success") || lower.Contains("completed") || lower.Contains("done")) return "line-success";
        return "";
    }

    private async Task DownloadSpec()
    {
        var fileName = _build?.Data?.SpecName ?? "build.spec";
        if (!fileName.EndsWith(".spec")) fileName += ".spec";
        await JS.InvokeVoidAsync("downloadFileWithAuth", $"/api/builds/{Id}/spec", fileName);
    }

    private async Task DownloadAllArtifacts()
    {
        await JS.InvokeVoidAsync("downloadFileWithAuth", $"/api/builds/{Id}/artifacts", "artifacts.zip");
    }

    private async Task DownloadArtifact(string fileName)
    {
        await JS.InvokeVoidAsync("downloadFileWithAuth", $"/api/builds/{Id}/artifacts/{Uri.EscapeDataString(fileName)}", fileName);
    }

    private async Task FlushPendingLogLinesAsync()
    {
        if (_pendingLogLines.IsEmpty) return;

        while (_pendingLogLines.TryDequeue(out var line))
        {
            var cleaned = new string(line.Where(c => !char.IsControl(c) || c == '\t').ToArray());
            if (!string.IsNullOrWhiteSpace(cleaned))
                _logLines.Add(cleaned);
        }

        if (_logLines.Count > MaxRetainedLogLines)
        {
            var removeCount = _logLines.Count - MaxRetainedLogLines;
            _logLines.RemoveRange(0, removeCount);
            _droppedLogLineCount += removeCount;
        }

        StateHasChanged();
        if (_followTail && string.IsNullOrWhiteSpace(_logSearch))
        {
            await JS.InvokeVoidAsync("scrollBuildLogsToEnd", "console-body");
        }
    }

    private async Task CopyLogs()
    {
        var copied = await JS.InvokeAsync<bool>("copyTextToClipboard", string.Join('\n', _logLines));
        _logsCopied = copied;
        _logActionMessage = copied ? "Build logs copied to clipboard." : "Could not copy build logs.";
        StateHasChanged();

        if (copied)
        {
            await Task.Delay(TimeSpan.FromSeconds(2));
            _logsCopied = false;
            StateHasChanged();
        }
    }

    private async Task DownloadLogs()
    {
        var fileName = $"build-{Id:N}.log";
        await JS.InvokeVoidAsync("downloadTextFile", fileName, string.Join('\n', _logLines));
        _logActionMessage = "Build log download started.";
    }

    private string GetStreamStateText() => _streamState switch
    {
        LogStreamState.Live => "Live",
        LogStreamState.Reconnecting => "Reconnecting",
        LogStreamState.Disconnected => "Disconnected",
        _ => "Connecting"
    };

    private string GetStreamBadgeClass() => _streamState switch
    {
        LogStreamState.Live => "bg-primary building-pulse",
        LogStreamState.Disconnected => "bg-danger",
        _ => "bg-warning text-dark"
    };

    private enum LogStreamState
    {
        Connecting,
        Live,
        Reconnecting,
        Disconnected
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private string GetStatusBorderClass(BuildStatus s) => s switch
    {
        BuildStatus.Success => "border-success",
        BuildStatus.Failed => "border-danger",
        BuildStatus.Building => "border-primary",
        BuildStatus.Cancelled => "border-secondary",
        _ => ""
    };

    private string GetStatusDotClass(BuildStatus s) => s switch
    {
        BuildStatus.Queued => "status-dot queued",
        BuildStatus.Building => "status-dot running",
        BuildStatus.Success => "status-dot success",
        BuildStatus.Failed => "status-dot failed",
        BuildStatus.Cancelled => "status-dot pending",
        _ => "status-dot"
    };

    private string GetStatusTextClass(BuildStatus s) => s switch
    {
        BuildStatus.Success => "text-success",
        BuildStatus.Failed => "text-danger",
        BuildStatus.Building => "text-primary",
        BuildStatus.Cancelled => "text-muted",
        _ => ""
    };

    private string GetScanBadge(ScanStatus s) => s switch
    {
        ScanStatus.Pending => "badge bg-warning",
        ScanStatus.Running => "badge bg-primary",
        ScanStatus.Completed => "badge bg-success",
        ScanStatus.Failed => "badge bg-danger",
        _ => "badge bg-secondary"
    };

    [Inject] private IJSRuntime JS { get; set; } = default!;
