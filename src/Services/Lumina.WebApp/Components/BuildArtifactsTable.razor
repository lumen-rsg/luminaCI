@using Lumina.Shared.DTOs
@using Lumina.Shared.Models.Enums

<section aria-labelledby="build-artifacts-title">
    <h2 id="build-artifacts-title" class="section-title mt-4">Artifacts</h2>
    <div class="card animate-slide-in">
        <div class="table-responsive">
            <table class="table table-hover">
                <caption class="visually-hidden">Build artifacts and verification status</caption>
                <thead>
                    <tr>
                        <th scope="col">Artifact</th>
                        <th scope="col">Size</th>
                        <th scope="col">SHA-256</th>
                        <th scope="col">Signature</th>
                        <th scope="col">CVE scan</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var artifact in Artifacts)
                    {
                        <tr>
                            <th scope="row">
                                <strong class="text-bright">@artifact.FileName</strong>
                                <code class="artifact-id" title="@artifact.Id">@artifact.Id.ToString()[..8]</code>
                            </th>
                            <td>@FormatFileSize(artifact.FileSize)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(artifact.HashSha256))
                                {
                                    <code class="digest">@artifact.HashSha256</code>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(string.IsNullOrEmpty(artifact.SigningKeyFingerprint) ? "bg-danger" : "bg-success")">
                                    @(string.IsNullOrEmpty(artifact.SigningKeyFingerprint) ? "NOT SIGNED" : "SIGNED")
                                </span>
                            </td>
                            <td><span class="@ScanBadge(artifact.CveScanStatus)">@artifact.CveScanStatus</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-success"
                                        aria-label="Download @artifact.FileName"
                                        @onclick="() => DownloadRequested.InvokeAsync(artifact.FileName)">
                                    <Icon Name="download" /> Download
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<BuildArtifactResponse> Artifacts { get; set; } = [];
    [Parameter] public EventCallback<string> DownloadRequested { get; set; }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string ScanBadge(ScanStatus status) => status switch
    {
        ScanStatus.Pending => "badge bg-warning",
        ScanStatus.Running => "badge bg-primary",
        ScanStatus.Completed => "badge bg-success",
        ScanStatus.Failed => "badge bg-danger",
        _ => "badge bg-secondary"
    };
}
