@inherits LayoutComponentBase
@inject Lumina.WebApp.Services.ThemeService Theme

<div class="login-layout">
    <button class="theme-toggle login-theme-toggle" @onclick="ToggleTheme" title="@(Theme.IsDark ? "Switch to light theme" : "Switch to dark theme")" aria-label="Toggle theme">
        <Icon Name="@(Theme.IsDark ? "sun" : "moon")" />
    </button>
    <div class="login-container">
        <div class="login-logo">
            <div class="login-logo-icon">L</div>
            <h1>Lumina CI</h1>
            <p class="text-muted">Continuous Integration Platform</p>
        </div>
        @Body
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Theme.InitializeAsync();
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleThemeAsync();
    }
}
