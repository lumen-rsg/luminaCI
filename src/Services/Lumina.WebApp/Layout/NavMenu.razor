@inject Lumina.WebApp.Services.LuminaApiService Api
@inject Lumina.WebApp.Services.AuthService Auth
@inject NavigationManager Nav

<div class="sidebar">
    <div class="sidebar-brand">
        <a href="/" aria-label="Lumina CI dashboard">
            <span class="brand-icon">L</span>
            <span>Lumina CI</span>
        </a>
    </div>

    @if (Auth.IsAuthenticated)
    {
        <nav class="sidebar-nav" aria-label="Primary navigation">
            <div class="sidebar-section">Overview</div>
            <ul class="nav flex-column" style="list-style:none;padding:0;margin:0;">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" aria-label="Dashboard">
                        <span class="nav-icon"><Icon Name="gauge" /></span>
                        <span>Dashboard</span>
                    </NavLink>
                </li>
            </ul>

            <div class="sidebar-section">CI/CD</div>
            <ul class="nav flex-column" style="list-style:none;padding:0;margin:0;">
                <li class="nav-item">
                    <NavLink class="nav-link" href="pipelines" aria-label="Pipelines">
                        <span class="nav-icon"><Icon Name="flow" /></span>
                        <span>Pipelines</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="builds" aria-label="@($"Builds, {_queueBadge} active")">
                        <span class="nav-icon"><Icon Name="hammer" /></span>
                        <span>Builds</span>
                        @if (_queueBadge > 0)
                        {
                            <span class="nav-badge" aria-label="@($"{_queueBadge} active builds")">@_queueBadge</span>
                        }
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="sources" aria-label="Sources">
                        <span class="nav-icon"><Icon Name="package" /></span>
                        <span>Sources</span>
                    </NavLink>
                </li>
            </ul>

            <div class="sidebar-section">Management</div>
            <ul class="nav flex-column" style="list-style:none;padding:0;margin:0;">
                <li class="nav-item">
                    <NavLink class="nav-link" href="security" aria-label="Security">
                        <span class="nav-icon"><Icon Name="shield" /></span>
                        <span>Security</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="repositories" aria-label="Repositories">
                        <span class="nav-icon"><Icon Name="database" /></span>
                        <span>Repositories</span>
                    </NavLink>
                </li>
            </ul>
        </nav>
    }

    <div class="sidebar-footer">
        @if (Auth.IsAuthenticated)
        {
            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="DoLogout">
                <Icon Name="logout" /> Logout
            </button>
        }
        else
        {
            <a href="/login" class="btn btn-sm btn-primary w-100">
                <Icon Name="login" /> Sign In
            </a>
        }
        <small class="mt-2 d-block text-muted">Lumina CI v1.0</small>
    </div>
</div>

@code {
    private int _queueBadge;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += StateChanged;
        if (Auth.IsAuthenticated)
        {
            await LoadQueueBadge();
        }
    }

    private async Task LoadQueueBadge()
    {
        try
        {
            var queue = await Api.GetBuildQueueAsync();
            _queueBadge = (queue?.Data?.QueuedCount ?? 0) + (queue?.Data?.RunningCount ?? 0);
        }
        catch { /* sidebar badge is non-critical */ }
    }

    private async Task DoLogout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void StateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= StateChanged;
    }
}
