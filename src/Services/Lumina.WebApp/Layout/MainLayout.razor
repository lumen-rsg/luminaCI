@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Lumina.WebApp.Services.AuthService Auth
@inject Lumina.WebApp.Services.ThemeService Theme

<div class="layout">
    <NavMenu />
    <main class="main-content">
        <header class="top-bar">
            <div class="breadcrumb">
                <a href="/">console.lumina.1t.ru</a>
                @foreach (var seg in GetBreadcrumbs())
                {
                    <span class="separator"><Icon Name="chevron-right" /></span>
                    if (seg.Link != null)
                    {
                        <a href="@seg.Link">@seg.Label</a>
                    }
                    else
                    {
                        <span class="current">@seg.Label</span>
                    }
                }
            </div>
            <div class="top-bar-actions">
                <span class="text-xs text-muted d-flex align-items-center gap-2">
                    <Icon Name="calendar" /> @DateTime.Now.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </span>
                <button class="theme-toggle" @onclick="ToggleTheme" title="@(Theme.IsDark ? "Switch to light theme" : "Switch to dark theme")" aria-label="Toggle theme">
                    <Icon Name="@(Theme.IsDark ? "sun" : "moon")" />
                </button>
            </div>
        </header>
        <div class="content-wrapper">
            @Body
        </div>
    </main>
</div>

@code {
    private record BreadcrumbSegment(string Label, string? Link);

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        Theme.OnThemeChanged += StateHasChanged;

        // Auth gate (SEC-05): now that the token lives in an HttpOnly cookie, we
        // can't read it from localStorage before Blazor loads. Resolve the auth
        // state from the server instead and bounce anonymous users to /login.
        if (!Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        await Theme.InitializeAsync();
    }

    private async Task ToggleTheme()
    {
        await Theme.ToggleThemeAsync();
    }

    private List<BreadcrumbSegment> GetBreadcrumbs()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrEmpty(path) || path == "/") return new();

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var result = new List<BreadcrumbSegment>();

        for (int i = 0; i < segments.Length; i++)
        {
            var seg = segments[i];
            var label = seg.Length <= 8 ? seg : seg[..8] + "...";

            // Try to make it readable
            label = label switch
            {
                "builds" => "Builds",
                "pipelines" => "Pipelines",
                "security" => "Security",
                "repositories" => "Repositories",
                _ => label
            };

            if (i < segments.Length - 1)
            {
                var link = "/" + string.Join("/", segments[..(i + 1)]);
                result.Add(new BreadcrumbSegment(label, link));
            }
            else
            {
                result.Add(new BreadcrumbSegment(label, null));
            }
        }

        return result;
    }
}
