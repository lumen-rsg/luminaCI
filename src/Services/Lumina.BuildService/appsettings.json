{
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Database=lumina_ci;Username=lumina;Password=CHANGE_ME_IN_PRODUCTION"
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Username": "lumina",
    "Password": "CHANGE_ME"
  },
  "Docker": {
    "SocketPath": "unix:///var/run/docker.sock",
    "BuildNetwork": "lumina-buildnet",
    "BuildMemoryBytes": 2147483648,
    "BuildPidsLimit": 512,
    "BuildCpuQuota": 150000,
    "AllowedBuildImages": [
      "lumina-rpm-build:f44-v1",
      "lumina-dotnet-build:f44-v1",
      "lumina-rpm-build:f44-aarch64-v1"
    ]
  },
  "Kubernetes": {
    "Namespace": "lumina-builds",
    "RunnerImages": {},
    "Jobs": {
      "ActiveDeadlineSeconds": 7200,
      "TtlSecondsAfterFinished": 86400,
      "CpuRequest": "500m",
      "CpuLimit": "2",
      "MemoryRequest": "1Gi",
      "MemoryLimit": "4Gi",
      "EphemeralStorageRequest": "4Gi",
      "EphemeralStorageLimit": "16Gi"
    }
  },
  "BuildMonitoring": {
    "MaxConcurrentBuilds": 4,
    "LeaseSeconds": 60,
    "HeartbeatSeconds": 15,
    "MaxBuildMinutes": 120
  },
  "ExtraSources": {
    "MaxFileSizeBytes": 1073741824
  },
  "Secrets": {
    "MasterKey": "CHANGE_ME_SECRETS_MASTER_KEY"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "Urls": "http://0.0.0.0:5001"
}
