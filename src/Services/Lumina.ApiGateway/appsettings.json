{
  "Urls": "http://0.0.0.0:5000",
  "Jwt": {
    "Authority": "https://console.lumina.1t.ru",
    "Audience": "lumina-api",
    "SigningKey": "CHANGE_ME_MIN_32_CHARS_JWT_SECRET_KEY",
    "Issuer": "LuminaCI",
    "Secret": "CHANGE_ME_MIN_32_CHARS_JWT_SECRET_KEY",
    "AccessMinutes": 15,
    "RefreshHours": 8,
    "CookieSecure": true
  },
  "RateLimit": {
    "Global": {
      "PermitLimit": 100,
      "TokensPerSecond": 100,
      "QueueLimit": 10
    },
    "Login": {
      "PermitLimit": 5,
      "TokensPerSecond": 5,
      "QueueLimit": 0
    }
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "MaxLockoutMinutes": 1440
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "build-logs-stream-route": {
        "ClusterId": "build-cluster-stream",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/builds/{id}/logs/stream"
        }
      },
      "build-route": {
        "ClusterId": "build-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/builds/{**catch-all}"
        }
      },
      "pipeline-route": {
        "ClusterId": "build-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/pipelines/{**catch-all}"
        }
      },
      "security-route": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/security/{**catch-all}"
        }
      },
      "scanner-route": {
        "ClusterId": "scanner-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/scanner/{**catch-all}"
        }
      },
      "repository-route": {
        "ClusterId": "repository-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/repository/{**catch-all}"
        }
      },
      "source-route": {
        "ClusterId": "source-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/sources/{**catch-all}"
        }
      },
      "extra-sources-route": {
        "ClusterId": "build-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/extra-sources/{**catch-all}"
        }
      },
      "webhook-route": {
        "ClusterId": "build-cluster",
        "Match": {
          "Path": "/api/webhooks/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      }
    },
    "Clusters": {
      "build-cluster-stream": {
        "Destinations": {
          "destination": {
            "Address": "http://build-service:5001"
          }
        },
        "HttpRequest": {
          "Timeout": "01:00:00",
          "ActivityTimeout": "01:00:00"
        }
      },
      "build-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://build-service:5001"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "Timeout": "00:30:00",
          "ActivityTimeout": "00:30:00"
        }
      },
      "security-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://security-service:5002"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "Timeout": "00:01:00",
          "ActivityTimeout": "00:01:00"
        }
      },
      "scanner-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://scanner-service:5003"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "Timeout": "00:02:00",
          "ActivityTimeout": "00:02:00"
        }
      },
      "repository-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://repository-service:5004"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "Timeout": "00:01:00",
          "ActivityTimeout": "00:01:00"
        }
      },
      "source-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://source-service:5006"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "Timeout": "00:02:00",
          "ActivityTimeout": "00:02:00"
        }
      }
    }
  }
}