<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Framework reference gives us the ASP.NET Core shared types
       (Microsoft.AspNetCore.Authentication, Authorization, etc.). The
       JwtBearer assembly ships as a NuGet package and is added below so this
       library can be consumed from non-Web SDK projects too. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0-preview.3.25161.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0-preview.3.25161.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.12.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.12.1" />
  </ItemGroup>

  <!-- Domain exception types (DomainException, NotFoundException, ...) that the
       ApiResult mapper translates into structured HTTP responses. -->
  <ItemGroup>
    <ProjectReference Include="..\Lumina.Shared\Lumina.Shared.csproj" />
  </ItemGroup>

</Project>
